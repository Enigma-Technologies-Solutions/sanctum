# Build output — generated by `pnpm build` / `pnpm tauri build`
dist/
# dist-isolation/ is NOT ignored — it contains static source files
# (the Tauri Isolation Pattern IPC hook) that are required at build time.

# Tauri build
src-tauri/target/
src-tauri/crates/*/target/
src-tauri/gen/

# Node
node_modules/

# Env
.env
.env.*

# Updater signing keys — the private key is the root of trust for every update
# Sanctum will ever ship. It lives outside the repo (~/.tauri/) and must never
# be committed, even accidentally.
*.key
*.key.pub

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Sanctum bundle signing keys (sanctum-bundle keygen). Name key files *.sanctum-key.
*.sanctum-key
