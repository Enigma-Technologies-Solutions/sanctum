{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanctum-registry-app",
  "$comment": "apps/<app_id>.json. Not signed on its own: the index pins its SHA-256.",
  "type": "object",
  "required": ["format", "app_id", "description", "changelog"],
  "properties": {
    "format": { "const": "sanctum-registry-app/1" },
    "app_id": { "$ref": "common.schema.json#/$defs/appId" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "homepage": { "$ref": "common.schema.json#/$defs/httpsUrl" },
    "source": { "$ref": "common.schema.json#/$defs/httpsUrl" },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "changelog": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["version", "date", "changes"],
        "properties": {
          "version": { "$ref": "common.schema.json#/$defs/version" },
          "date": { "$ref": "common.schema.json#/$defs/date" },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "type": { "enum": ["added", "changed", "fixed", "security", "removed"] },
                "text": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          }
        }
      }
    },
    "manual": { "$ref": "common.schema.json#/$defs/manualAsset" },
    "screenshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "width", "height", "alt"],
        "properties": {
          "path": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5}\\.(png|webp)$" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 1, "maximum": 2097152 },
          "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
          "alt": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
