{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanctum-registry-common",
  "$comment": "Shared definitions. Patterns avoid lookaround and backreferences so the Rust regex crate can use them unchanged.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "keyid": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{43}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
    "version": { "type": "string", "pattern": "^[0-9]{1,9}(\\.[0-9]{1,9}){0,3}$" },
    "appId": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "registryId": { "type": "string", "maxLength": 100, "pattern": "^registry:[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "unixTime": { "type": "integer", "minimum": 0, "maximum": 4102444800 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "httpsUrl": { "type": "string", "maxLength": 300, "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%/?=&#+-]*)?$" },
    "httpsBase": { "type": "string", "maxLength": 300, "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?/$" },
    "jsonPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5}\\.json$"
    },
    "bundleAsset": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5}\\.sanctum$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 33554432 }
      }
    },
    "detailAsset": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/jsonPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 2, "maximum": 262144 }
      }
    },
    "manualAsset": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5}\\.md$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "imageAsset": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5}\\.(png|webp)$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 2097152 }
      }
    },
    "iconAsset": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5}\\.(png|webp|svg)$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 262144 }
      }
    }
  }
}
