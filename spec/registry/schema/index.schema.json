{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanctum-registry-index",
  "$comment": "index.json. Unknown properties are allowed and ignored (they are still covered by the signature). Rules a schema cannot express are in docs/registry-format.md, section 'Rules beyond the schema'.",
  "type": "object",
  "required": ["format", "id", "name", "kind", "serial", "issued_at", "expires", "apps"],
  "properties": {
    "format": { "const": "sanctum-registry/1" },
    "id": { "$ref": "common.schema.json#/$defs/registryId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "kind": { "enum": ["public", "licensed"] },
    "serial": { "type": "integer", "minimum": 1 },
    "issued_at": { "$ref": "common.schema.json#/$defs/unixTime" },
    "expires": { "$ref": "common.schema.json#/$defs/unixTime" },
    "mirrors": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "common.schema.json#/$defs/httpsBase" }
    },
    "revocations": { "$ref": "common.schema.json#/$defs/jsonPath" },
    "apps": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "required": ["app_id", "name", "summary", "publisher", "access", "latest", "detail", "versions"],
      "properties": {
        "app_id": { "$ref": "common.schema.json#/$defs/appId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "maxLength": 200 },
        "publisher": {
          "type": "object",
          "required": ["keyid", "name"],
          "properties": {
            "keyid": { "$ref": "common.schema.json#/$defs/keyid" },
            "name": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        },
        "access": { "enum": ["free", "licensed"] },
        "latest": { "$ref": "common.schema.json#/$defs/version" },
        "icon": { "$ref": "common.schema.json#/$defs/iconAsset" },
        "detail": { "$ref": "common.schema.json#/$defs/detailAsset" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["version", "published_at", "bundle", "checksum", "declared"],
      "properties": {
        "version": { "$ref": "common.schema.json#/$defs/version" },
        "published_at": { "$ref": "common.schema.json#/$defs/unixTime" },
        "bundle": { "$ref": "common.schema.json#/$defs/bundleAsset" },
        "checksum": { "$ref": "common.schema.json#/$defs/sha256" },
        "declared": { "type": "array", "maxItems": 32 },
        "attestations": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/attestation" }
        }
      }
    },
    "attestation": {
      "type": "object",
      "required": ["kind", "keyid", "sig", "issued_at", "report"],
      "properties": {
        "kind": { "enum": ["review"] },
        "keyid": { "$ref": "common.schema.json#/$defs/keyid" },
        "sig": { "$ref": "common.schema.json#/$defs/signature" },
        "issued_at": { "$ref": "common.schema.json#/$defs/unixTime" },
        "report": { "$ref": "common.schema.json#/$defs/manualAsset" }
      }
    }
  }
}
