# Cloudflare Pages / Netlify header rules.
# The marketing site for a sandboxing product should be able to survive its own
# threat model: no third-party origins, no inline script, nothing to inject into.

/*
  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

# The registry is read by apps and scripts, and may be fetched by pages on other origins.
# Everything in it is verified by signature or hash, so being readable cross-origin adds
# nothing an attacker could use. (GitHub Pages already sends open CORS headers and ignores
# this file; Cloudflare Pages and Netlify honour it.)
/registry/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Fonts are content-addressed by filename, so cache them hard.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400
