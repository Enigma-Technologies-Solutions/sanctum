 e;\n          if (strict) fail(e.code, Object.assign({}, e.details, { index: i }), e.message);\n        }\n      } else if (item && isBytes(item.body) && (item.format === \"ss1\" || item.format === \"plain\")) {\n        share = item;\n      } else if (strict) {\n        fail(\"BAD_SYNTAX\", { index: i, reason: \"not a share\" });\n      }\n      if (share) out.push({ share: share, idx: i });\n    }\n    return out;\n  }\n\n  function dedupe(entries) {\n    var seen = Object.create(null);\n    var uniq = [];\n    var dups = 0;\n    for (var i = 0; i < entries.length; i++) {\n      var s = entries[i].share;\n      var key = s.format + \":\" + (s.setId || \"\") + \":\" + (s.threshold || 0) + \":\" + s.x + \":\" + toHex(s.body);\n      if (seen[key]) {\n        dups++;\n        continue;\n      }\n      seen[key] = true;\n      uniq.push(entries[i]);\n    }\n    return { uniq: uniq, dups: dups };\n  }\n\n  function validThreshold(t) {\n    return Number.isInteger(t) && t >= 2 && t <= 255;\n  }\n\n  // ----------------------------------------------------------------- validate\n\n  function validateShares(shares, options) {\n    var list = prepare(shares || [], false);\n    var problems = [];\n    var optT = options && validThreshold(options.threshold) ? options.threshold : null;\n\n    if (list.length === 0) {\n      return Object.freeze({\n        format: null,\n        setId: null,\n        threshold: null,\n        count: 0,\n        ignoredDuplicates: 0,\n        needed: null,\n        missing: 0,\n        canCombine: false,\n        problems: Object.freeze([]),\n      });\n    }\n\n    var first = list[0].share;\n    var formats = Object.create(null);\n    var i;\n    for (i = 0; i < list.length; i++) formats[list[i].share.format] = true;\n    var mixedFormats = Object.keys(formats).length > 1;\n    var format = mixedFormats ? \"mixed\" : first.format;\n\n    var dd = dedupe(list);\n    var uniq = dd.uniq;\n    var bad;\n\n    if (mixedFormats) {\n      bad = [];\n      for (i = 0; i < uniq.length; i++) if (uniq[i].share.format !== first.format) bad.push(uniq[i].idx);\n      problems.push({ code: \"MIXED_FORMATS\", indices: bad });\n    }\n\n    var setId = null;\n    var threshold = null;\n    var ss1s = uniq.filter(function (e) {\n      return e.share.format === \"ss1\";\n    });\n    if (ss1s.length > 0) {\n      var ref = ss1s[0].share;\n      bad = [];\n      for (i = 0; i < ss1s.length; i++) {\n        if (ss1s[i].share.setId !== ref.setId || ss1s[i].share.threshold !== ref.threshold) bad.push(ss1s[i].idx);\n      }\n      if (bad.length > 0) problems.push({ code: \"MIXED_SETS\", indices: bad });\n      else if (!mixedFormats) {\n        setId = ref.setId;\n        threshold = ref.threshold;\n      }\n    }\n\n    bad = [];\n    for (i = 0; i < uniq.length; i++) if (uniq[i].share.body.length !== uniq[0].share.body.length) bad.push(uniq[i].idx);\n    if (bad.length > 0) problems.push({ code: \"LENGTH_MISMATCH\", indices: bad });\n\n    var byX = Object.create(null);\n    for (i = 0; i < uniq.length; i++) {\n      var xk = uniq[i].share.x;\n      (byX[xk] || (byX[xk] = [])).push(uniq[i].idx);\n    }\n    bad = [];\n    Object.keys(byX).forEach(function (k) {\n      if (byX[k].length > 1) bad = bad.concat(byX[k]);\n    });\n    if (bad.length > 0) {\n      bad.sort(function (a, b) {\n        return a - b;\n      });\n      problems.push({ code: \"DUPLICATE_X\", indices: bad });\n    }\n\n    var needed = first.format === \"ss1\" ? first.threshold : optT || 2;\n    var count = uniq.length;\n    var missing = Math.max(0, needed - count);\n    if (missing > 0) problems.push({ code: \"NOT_ENOUGH_SHARES\", indices: [] });\n\n    return Object.freeze({\n      format: format,\n      setId: setId,\n      threshold: threshold,\n      count: count,\n      ignoredDuplicates: dd.dups,\n      needed: needed,\n      missing: missing,\n      canCombine: problems.length === 0,\n      problems: Object.freeze(\n        problems.map(function (p) {\n          return Object.freeze({ code: p.code, indices: p.indices });\n        })\n      ),\n    });\n  }\n\n  // ------------------------------------------------------------------ combine\n\n  function combine(shares, options) {\n    var inputs = Array.isArray(shares) ? shares : [];\n    var entries = prepare(inputs, true);\n    if (entries.length === 0) fail(\"NO_SHARES\");\n\n    var first = entries[0].share;\n    var i;\n    for (i = 1; i < entries.length; i++) {\n      if (entries[i].share.format !== first.format) fail(\"MIXED_FORMATS\", { index: entries[i].idx });\n    }\n    var format = first.format;\n\n    var optT = null;\n    if (format === \"plain\" && options && options.threshold !== undefined && options.threshold !== null) {\n      if (!validThreshold(options.threshold)) {\n        fail(\"BAD_OPTION\", { option: \"threshold\", min: 2, max: 255, have: options.threshold });\n      }\n      optT = options.threshold;\n    }\n\n    var dd = dedupe(entries);\n    var uniq = dd.uniq;\n\n    if (format === \"ss1\") {\n      for (i = 1; i < uniq.length; i++) {\n        if (uniq[i].share.setId !== uniq[0].share.setId || uniq[i].share.threshold !== uniq[0].share.threshold) {\n          fail(\"MIXED_SETS\", { index: uniq[i].idx });\n        }\n      }\n    }\n    for (i = 1; i < uniq.length; i++) {\n      if (uniq[i].share.body.length !== uniq[0].share.body.length) fail(\"LENGTH_MISMATCH\", { index: uniq[i].idx });\n    }\n    var seenX = Object.create(null);\n    for (i = 0; i < uniq.length; i++) {\n      var x = uniq[i].share.x;\n      if (seenX[x]) fail(\"DUPLICATE_X\", { x: x });\n      seenX[x] = true;\n    }\n\n    var need = format === \"ss1\" ? first.threshold : optT || 2;\n    if (uniq.length < need) fail(\"NOT_ENOUGH_SHARES\", { have: uniq.length, need: need });\n\n    var t = format === \"ss1\" ? need : optT || uniq.length;\n    var use = uniq.slice(0, t);\n    var extra = uniq.slice(t);\n    var raws = use.map(function (e) {\n      return e.share.body;\n    });\n    var payload = interpolate(raws, 0);\n\n    var mismatched = [];\n    for (i = 0; i < extra.length; i++) {\n      var want = interpolate(raws, extra[i].share.x);\n      var have = extra[i].share.body;\n      var same = true;\n      for (var b = 0; b < want.length; b++) {\n        if (want[b] !== have[b]) {\n          same = false;\n          break;\n        }\n      }\n      if (!same) mismatched.push(extra[i].idx);\n    }\n\n    if (format === \"plain\") {\n      if (mismatched.length > 0) {\n        wipe(payload);\n        fail(\"INCONSISTENT_SHARES\", { indices: mismatched });\n      }\n      return Object.freeze({\n        secret: payload,\n        format: \"plain\",\n        threshold: optT,\n        setId: null,\n        verified: false,\n        sharesUsed: t,\n        ignoredDuplicates: dd.dups,\n        warnings: Object.freeze([]),\n      });\n    }\n\n    // ss1: LEN(2) || secret || zero padding || TAG(4)\n    var ok = payload.length >= 7;\n    var ln = 0;\n    if (ok) {\n      ln = (payload[0] << 8) | payload[1];\n      ok = ln >= 1 && 2 + ln + 4 <= payload.length;\n    }\n    if (ok) {\n      var padEnd = payload.length - 4;\n      var pad = 0;\n      for (i = 2 + ln; i < padEnd; i++) pad |= payload[i];\n      var tag = makeTag(payload.subarray(0, 2), payload.subarray(2, 2 + ln));\n      var diff = pad;\n      for (i = 0; i < 4; i++) diff |= tag[i] ^ payload[padEnd + i];\n      ok = diff === 0;\n    }\n    if (!ok) {\n      wipe(payload);\n      fail(\"INTEGRITY_FAILED\", { extraMismatch: mismatched });\n    }\n    var secret = payload.slice(2, 2 + ln);\n    wipe(payload);\n    return Object.freeze({\n      secret: secret,\n      format: \"ss1\",\n      threshold: first.threshold,\n      setId: first.setId,\n      verified: true,\n      sharesUsed: t,\n      ignoredDuplicates: dd.dups,\n      warnings: Object.freeze(\n        mismatched.length > 0 ? [Object.freeze({ code: \"EXTRA_SHARE_MISMATCH\", inputIndices: mismatched })] : []\n      ),\n    });\n  }\n\n  // ------------------------------------------------------------------- export\n\n  var api = Object.freeze({\n    LIMITS: LIMITS,\n    LABEL_PATTERN: LABEL_PATTERN,\n    ShamirError: ShamirError,\n    split: split,\n    parseShare: parseShare,\n    parseShares: parseShares,\n    validateShares: validateShares,\n    combine: combine,\n    toHex: toHex,\n    fromHex: fromHex,\n    utf8Encode: utf8Encode,\n    utf8Decode: utf8Decode,\n    sha256: sha256,\n    randomSecret: randomSecret,\n    entropyBits: entropyBits,\n    isValidLabel: isValidLabel,\n    wipe: wipe,\n    gf256: Object.freeze({ mul: gfMul, inv: gfInv }),\n  });\n\n  globalThis.ShamirCore = api;\n  if (typeof module !== \"undefined\" && module.exports) module.exports = api;\n})();\n</script>\n<script>\n(function(){\n\"use strict\";\nvar C = globalThis.ShamirCore;\nfunction $(id){ return document.getElementById(id); }\n\nif(!C){ $(\"noCore\").hidden = false; return; }\nif(!(globalThis.crypto && typeof crypto.getRandomValues === \"function\")){ $(\"noCrypto\").hidden = false; }\n\nvar MAXB = C.LIMITS.MAX_SECRET_BYTES;\n\n/* ---------- small helpers ---------- */\nvar toastTimer = null;\nfunction toast(msg){\n  var t = $(\"toast\"); t.textContent = msg; t.hidden = false;\n  clearTimeout(toastTimer); toastTimer = setTimeout(function(){ t.hidden = true; }, 1800);\n}\nfunction icon(name){ return '<svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-' + name + '\"></use></svg>'; }\nfunction setIcon(btn, name, label){\n  btn.querySelector(\"use\").setAttribute(\"href\", \"#i-\" + name);\n  if(label != null) btn.querySelector(\"span\").textContent = label;\n}\nfunction el(tag, cls, text){\n  var e = document.createElement(tag);\n  if(cls) e.className = cls;\n  if(text != null) e.textContent = text;\n  return e;\n}\nfunction plural(n, one, many){ return n + \" \" + (n === 1 ? one : many); }\nfunction eqBytes(a, b){\n  if(a.length !== b.length) return false;\n  var d = 0; for(var i = 0; i < a.length; i++) d |= a[i] ^ b[i];\n  return d === 0;\n}\n/* Let the browser paint the busy state first: rAF, then a timeout. The timer is a fallback for hidden windows. */\nfunction frame(fn){\n  var done = false;\n  function go(){ if(done) return; done = true; fn(); }\n  if(typeof requestAnimationFrame === \"function\") requestAnimationFrame(function(){ setTimeout(go, 0); });\n  setTimeout(go, 150);\n}\nfunction selectAll(t){ t.focus(); t.select(); }\n\n/* Copy with a selectable fallback. host: {box, area, msg?} */\nfunction copyText(text, okMsg, host){\n  function fallback(){\n    host.box.hidden = false; host.area.value = text; selectAll(host.area);\n    var done = false;\n    try { done = document.execCommand(\"copy\"); } catch(e){ done = false; }\n    if(done){ toast(okMsg); host.box.hidden = true; host.area.value = \"\"; }\n  }\n  if(navigator.clipboard && navigator.clipboard.writeText){\n    navigator.clipboard.writeText(text).then(function(){\n      host.box.hidden = true; host.area.value = \"\"; toast(okMsg);\n    }, fallback);\n  } else { fallback(); }\n}\n\n/* ---------- typed error copy ---------- */\nfunction errText(code, d, ctx){\n  d = d || {}; ctx = ctx || {};\n  switch(code){\n    case \"SECRET_EMPTY\": return \"Enter a secret first.\";\n    case \"SECRET_TOO_LONG\": return \"The secret is \" + d.have + \" bytes. The limit is \" + d.max + \".\";\n    case \"BAD_SHARE_COUNT\": return \"Shares must be a whole number from 2 to 255.\";\n    case \"BAD_THRESHOLD\":\n      if(ctx.onShare) return \"This share's needed number is not valid.\";\n      return \"Needed shares must be a whole number from 2 up to the number of shares\" + (d.max ? \" (\" + d.max + \").\" : \".\");\n    case \"BAD_OPTION\":\n      if(d.option === \"padTo\") return \"Hiding the secret length is only available for Sanctum shares.\";\n      if(d.option === \"threshold\") return \"How many shares were needed must be a whole number from 2 to 255.\";\n      return \"Labels use letters, digits, dot, underscore and hyphen, up to 32 characters, and cannot contain the part \\\"ss1\\\".\";\n    case \"RANDOM_UNAVAILABLE\": return \"This window has no secure random source, so nothing was split.\";\n    case \"EMPTY_INPUT\": return \"Nothing to read.\";\n    case \"BAD_SYNTAX\": return \"This does not look like a share. A Sanctum share looks like ss1-3-0b704569-...-c852.\";\n    case \"BAD_HEX\": return \"The share has a character that is not 0 to 9 or a to f, or an odd number of digits. Check for a missing or extra character.\";\n    case \"SHARE_TOO_SHORT\": return \"This share is too short to be complete.\";\n    case \"X_OUT_OF_RANGE\": return \"This share has an invalid position (0). It is damaged.\";\n    case \"BAD_CHECKSUM\": return \"The end of this share does not match its contents. A character was probably mistyped or lost. Copy it again.\";\n    case \"NO_SHARES\": return \"Paste the shares first.\";\n    case \"MIXED_FORMATS\": return \"Sanctum shares and plain shares cannot be combined with each other.\";\n    case \"MIXED_SETS\": return \"These shares come from different sets.\" + (ctx.setIds && ctx.setIds.length > 1 ? \" Set ids found: \" + ctx.setIds.join(\", \") + \".\" : \"\") + \" Use shares that have the same set id.\";\n    case \"LENGTH_MISMATCH\": return \"These shares are not the same length, so they are not from one set.\";\n    case \"DUPLICATE_X\": return \"Two different shares claim the same position\" + (d.x != null ? \" (\" + d.x + \")\" : \"\") + \". One of them is wrong.\";\n    case \"TYPO_MINOR_SANCTUM\": return \"This looks like a Sanctum share but the others are plain shares. Remove it, or remove the others.\";\n    case \"TYPO_MINOR_PLAIN\": return \"This looks like a plain share but the others are Sanctum shares. Remove it, or remove the others.\";\n    case \"NOT_ENOUGH_SHARES\":\n      if(d.have != null && d.need != null) return d.have + \" of \" + d.need + \" needed. Add \" + (d.need - d.have) + \" more.\";\n      return \"Not enough shares.\";\n    case \"INCONSISTENT_SHARES\":\n      return (d.indices && d.indices.length > 1 ? \"Shares \" : \"Share \") + posList(d.indices, ctx) + (d.indices && d.indices.length > 1 ? \" do not agree\" : \" does not agree\") + \" with the others. Replace \" + (d.indices && d.indices.length > 1 ? \"them.\" : \"it.\");\n    case \"INTEGRITY_FAILED\":\n      return \"The shares did not rebuild a valid secret. At least one share is wrong, or they belong to different sets.\" + (ctx.need ? \" If you have more than \" + ctx.need + \" shares, try leaving one out.\" : \"\");\n  }\n  return \"Something went wrong (\" + code + \").\";\n}\nfunction posList(indices, ctx){\n  var toks = ctx.tokens || [];\n  return (indices || []).map(function(i){\n    var t = toks[i];\n    return t && t.share ? t.share.x : \"at entry \" + (i + 1);\n  }).join(\", \");\n}\nfunction errOf(e, ctx){\n  if(e && e.code) return errText(e.code, e.details, ctx);\n  return \"Something went wrong. Nothing was changed.\";\n}\n\n/* ---------- masking and idle timer ---------- */\nvar splitShown = false, combineShown = false, idleTimer = null;\nvar mode = \"text\";           // split secret entry mode\nvar viewMode = \"text\";       // combine result view\nfunction applySplitMask(){\n  $(\"secret\").classList.toggle(\"masked\", !splitShown);\n  $(\"sToggle\").setAttribute(\"aria-pressed\", String(splitShown));\n  setIcon($(\"sToggle\"), splitShown ? \"eye-off\" : \"eye\", splitShown ? \"Hide\" : \"Show\");\n  refreshSplitHash();\n}\nfunction hideFallbacks(){\n  [\"splitFallback\", \"combineFallback\"].forEach(function(id){ $(id).hidden = true; });\n  $(\"splitFallbackText\").value = \"\"; $(\"combineFallbackText\").value = \"\";\n}\nfunction remaskAll(){\n  hideFallbacks();\n  splitShown = false; combineShown = false;\n  applySplitMask(); applyCombineView();\n  $(\"sHashBox\").open = false; $(\"cHashBox\").open = false;\n}\nfunction bumpIdle(){\n  clearTimeout(idleTimer);\n  idleTimer = setTimeout(function(){ remaskAll(); }, 60000);\n}\n\n/* ---------- tabs ---------- */\nfunction selectTab(which){\n  var split = which === \"split\";\n  $(\"tabSplit\").setAttribute(\"aria-selected\", String(split));\n  $(\"tabCombine\").setAttribute(\"aria-selected\", String(!split));\n  $(\"tabSplit\").tabIndex = split ? 0 : -1;\n  $(\"tabCombine\").tabIndex = split ? -1 : 0;\n  $(\"panelSplit\").hidden = !split;\n  $(\"panelCombine\").hidden = split;\n  remaskAll();\n}\n$(\"tabSplit\").addEventListener(\"click\", function(){ selectTab(\"split\"); });\n$(\"tabCombine\").addEventListener(\"click\", function(){ selectTab(\"combine\"); });\n[$(\"tabSplit\"), $(\"tabCombine\")].forEach(function(b){\n  b.addEventListener(\"keydown\", function(ev){\n    var next = null;\n    if(ev.key === \"ArrowRight\" || ev.key === \"ArrowLeft\") next = b === $(\"tabSplit\") ? \"combine\" : \"split\";\n    else if(ev.key === \"Home\") next = \"split\";\n    else if(ev.key === \"End\") next = \"combine\";\n    if(next){\n      selectTab(next); (next === \"split\" ? $(\"tabSplit\") : $(\"tabCombine\")).focus(); ev.preventDefault();\n    }\n  });\n});\n\n/* ================= SPLIT ================= */\nvar splitState = \"idle\";   // idle | working | done | stale\nvar clearVer = 0;          // bumped by Clear; deferred results are then dropped\nvar inputVer = 0;          // bumped on every Split input; lets deferred work notice edits\nvar shareTexts = [];\nvar splitK = 0;\n\nfunction readSecret(){\n  var v = $(\"secret\").value;\n  if(mode === \"text\") return { bytes: C.utf8Encode(v) };\n  try { return { bytes: C.fromHex(v.replace(/\\s+/g, \"\")) }; }\n  catch(e){ return { err: \"Hex needs an even number of digits, using only 0 to 9 and a to f.\" }; }\n}\nfunction updateSecretCount(){\n  var s = readSecret(), c = $(\"sCount\"), over = false;\n  var se = $(\"sErr\");\n  if(s.err){\n    c.textContent = \"Not valid hex\"; c.classList.add(\"err\");\n    se.textContent = s.err; se.hidden = false; $(\"secret\").setAttribute(\"aria-invalid\", \"true\");\n    return { over: false, bad: true };\n  }\n  var n = s.bytes.length; over = n > MAXB;\n  c.textContent = n + \" of \" + MAXB + \" bytes\";\n  c.classList.toggle(\"err\", over);\n  se.hidden = !over; se.textContent = over ? errText(\"SECRET_TOO_LONG\", { have: n, max: MAXB }) : \"\";\n  $(\"secret\").setAttribute(\"aria-invalid\", String(over));\n  C.wipe(s.bytes);\n  return { over: over, bad: false };\n}\nfunction refreshSplitHash(){\n  var out = $(\"sHash\");\n  if(!$(\"sHashBox\").open) { return; }\n  if(!splitShown){ out.textContent = \"Show the secret to see this value.\"; return; }\n  var s = readSecret();\n  if(s.err){ out.textContent = \"Enter valid hex to see this value.\"; return; }\n  if(!s.bytes.length){ out.textContent = \"Enter a secret to see this value.\"; return; }\n  out.textContent = C.toHex(C.sha256(s.bytes));\n  C.wipe(s.bytes);\n}\nfunction setMode(m){\n  if(m === mode) return;\n  mode = m;\n  $(\"modeText\").setAttribute(\"aria-pressed\", String(m === \"text\"));\n  $(\"modeHex\").setAttribute(\"aria-pressed\", String(m === \"hex\"));\n  $(\"secretLab\").textContent = m === \"text\" ? \"Secret (text, UTF-8)\" : \"Secret (hex digits)\";\n  $(\"sHint\").textContent = m === \"text\" ? \"Hidden while you type. Line breaks are kept.\" : \"Hidden while you type. Spaces and line breaks between digits are ignored.\";\n  $(\"secret\").value = \"\";\n  onSplitInput();\n}\n$(\"modeText\").addEventListener(\"click\", function(){ setMode(\"text\"); });\n$(\"modeHex\").addEventListener(\"click\", function(){ setMode(\"hex\"); });\n$(\"sToggle\").addEventListener(\"click\", function(){ splitShown = !splitShown; applySplitMask(); bumpIdle(); });\n$(\"sHashBox\").addEventListener(\"toggle\", refreshSplitHash);\n\nfunction markStale(){\n  if(splitState !== \"done\") return;\n  splitState = \"stale\";\n  $(\"splitResult\").classList.add(\"stale\");\n  $(\"splitStale\").hidden = false;\n  [\"btnCopyAll\", \"btnCheck\"].forEach(function(id){ $(id).disabled = true; });\n  Array.prototype.forEach.call($(\"shareList\").querySelectorAll(\"button\"), function(b){ b.disabled = true; });\n}\nfunction fmtValue(){ return document.querySelector('input[name=\"fmt\"]:checked').value; }\nfunction numVal(id){ var v = $(id).value.trim(); return v === \"\" ? NaN : Number(v); }\n\nfunction updateSentence(){\n  var n = numVal(\"nShares\"), k = numVal(\"kNeeded\");\n  var s = $(\"kSentence\"), w = $(\"kWarn\");\n  w.hidden = true;\n  var okN = Number.isInteger(n) && n >= 2 && n <= 255;\n  var okK = Number.isInteger(k) && k >= 2 && okN && k <= n;\n  $(\"nShares\").setAttribute(\"aria-invalid\", String(!okN));\n  $(\"kNeeded\").setAttribute(\"aria-invalid\", String(!okK));\n  if(!okN){ s.textContent = errText(\"BAD_SHARE_COUNT\"); s.className = \"sentence hint err\"; return; }\n  if(!okK){ s.textContent = errText(\"BAD_THRESHOLD\", { max: n }); s.className = \"sentence hint err\"; return; }\n  s.className = \"sentence\";\n  s.innerHTML = \"\";\n  s.appendChild(document.createTextNode(\"Any \"));\n  s.appendChild(el(\"b\", null, String(k)));\n  s.appendChild(document.createTextNode(\" of the \"));\n  s.appendChild(el(\"b\", null, String(n)));\n  s.appendChild(document.createTextNode(\" shares rebuild the secret. \" + (k - 1 === 1 ? \"1 share or fewer reveals\" : (k - 1) + \" or fewer reveal\") + \" nothing about it.\"));\n  var warn = null;\n  if(k === n) warn = \"Losing one share loses the secret.\";\n  else if(n > 50) warn = \"Many shares are hard to store safely.\";\n  if(warn){ w.hidden = false; w.querySelector(\"span\").textContent = warn; }\n}\nfunction updateLabelState(){\n  var v = $(\"label\").value, bad = v !== \"\" && !C.isValidLabel(v);\n  $(\"label\").setAttribute(\"aria-invalid\", String(bad));\n  $(\"labelHint\").classList.toggle(\"err\", bad);\n}\nfunction updatePadState(){\n  var plain = fmtValue() === \"plain\";\n  $(\"pad\").disabled = plain;\n  $(\"padHint\").textContent = plain\n    ? \"Not available with plain shares, which are exactly as long as the secret plus one byte.\"\n    : \"Rounds the hidden data up to a multiple of this size, so a share does not show the exact length. It hides the length inside that range, not the fact that a secret exists.\";\n}\nfunction updateSplitButton(){\n  var st = updateSecretCount();\n  $(\"btnSplit\").disabled = st.over || splitState === \"working\";\n}\nfunction onSplitInput(){\n  inputVer++;\n  updateSplitButton(); updateSentence(); updateLabelState(); updatePadState();\n  refreshSplitHash(); markStale(); bumpIdle();\n  $(\"splitMsg\").textContent = \"\"; $(\"splitMsg\").className = \"msg\"; $(\"splitMsg\").setAttribute(\"role\", \"status\");\n}\n[\"secret\", \"nShares\", \"kNeeded\", \"label\", \"pad\"].forEach(function(id){ $(id).addEventListener(\"input\", onSplitInput); });\nArray.prototype.forEach.call(document.querySelectorAll('input[name=\"fmt\"]'), function(r){ r.addEventListener(\"change\", onSplitInput); });\n\n$(\"sGen\").addEventListener(\"click\", function(){\n  var len = numVal(\"genLen\");\n  try {\n    var s = C.randomSecret({ length: len });\n    if(mode !== \"text\") setMode(\"text\");\n    $(\"secret\").value = s;\n    splitShown = true; applySplitMask();\n    $(\"genInfo\").textContent = \"Generated \" + s.length + \" characters, \" + C.entropyBits(s.length).toFixed(1) + \" bits of randomness.\";\n    $(\"genInfo\").classList.remove(\"err\");\n    onSplitInput();\n  } catch(e){\n    $(\"genInfo\").textContent = e && e.code === \"BAD_OPTION\" ? \"Length must be a whole number from 8 to 128.\"\n      : e && e.code === \"RANDOM_UNAVAILABLE\" ? \"This window has no secure random source, so no secret was generated.\" : errOf(e);\n    $(\"genInfo\").classList.add(\"err\");\n  }\n});\n$(\"genLen\").addEventListener(\"input\", function(){\n  var n = numVal(\"genLen\");\n  if(Number.isInteger(n) && n >= 8 && n <= 128){\n    $(\"genInfo\").classList.remove(\"err\");\n    $(\"genInfo\").textContent = \"Generate makes a random secret from 28 easy to read letters and digits. At \" + n + \" characters that is \" + C.entropyBits(n).toFixed(1) + \" bits.\";\n  }\n});\n\nfunction wipeSplitResult(){\n  $(\"btnCopyAll\").disabled = false; $(\"btnCheck\").disabled = false;\n  shareTexts = [];\n  $(\"shareList\").textContent = \"\";\n  $(\"splitResult\").hidden = true;\n  $(\"splitResult\").classList.remove(\"stale\");\n  $(\"splitStale\").hidden = true;\n  $(\"splitFallback\").hidden = true; $(\"splitFallbackText\").value = \"\";\n  $(\"checkMsg\").textContent = \"\";\n  splitState = \"idle\";\n}\nfunction clearSplit(){\n  clearVer++; inputVer++;\n  hideFallbacks();\n  $(\"secret\").value = \"\";\n  $(\"sHash\").textContent = \"Show the secret to see this value.\";\n  wipeSplitResult();\n  $(\"splitMsg\").textContent = \"\"; $(\"splitMsg\").className = \"msg\";\n  splitShown = false; applySplitMask();\n  $(\"sHashBox\").open = false;\n  updateSplitButton();\n}\n$(\"sClear\").addEventListener(\"click\", function(){ clearSplit(); toast(\"Cleared\"); });\n$(\"btnWipeSplit\").addEventListener(\"click\", function(){ clearSplit(); $(\"secret\").focus(); toast(\"Cleared\"); });\n\nfunction splitOptions(){\n  var o = { format: fmtValue() };\n  var lab = $(\"label\").value.trim();\n  if(lab) o.label = lab;\n  if(o.format === \"ss1\") o.padTo = Number($(\"pad\").value);\n  return o;\n}\nfunction showSplitError(text){\n  var m = $(\"splitMsg\"); m.setAttribute(\"role\", \"alert\"); m.textContent = text; m.className = \"msg err\";\n}\nfunction renderShares(res, k){\n  var list = $(\"shareList\"); list.textContent = \"\";\n  shareTexts = res.shares.map(function(s){ return s.text; });\n  splitK = k;\n  res.shares.forEach(function(s, i){\n    var li = el(\"li\", \"share\");\n    var head = el(\"div\", \"share-head\");\n    head.appendChild(el(\"span\", \"share-n\", \"Share \" + s.x));\n    var b = el(\"button\", \"btn ghost sm\");\n    b.type = \"button\";\n    b.innerHTML = icon(\"copy\") + \"<span>Copy</span>\";\n    b.setAttribute(\"aria-label\", \"Copy share \" + s.x);\n    b.addEventListener(\"click\", function(){ copyText(s.text, \"Copied share \" + s.x, splitHost); });\n    head.appendChild(b);\n    li.appendChild(head);\n    li.appendChild(el(\"p\", \"share-text\", s.text));\n    list.appendChild(li);\n  });\n  var sum = $(\"splitSummary\"); sum.textContent = \"\";\n  sum.appendChild(document.createTextNode(plural(res.shares.length, \"share\", \"shares\") + \". Any \" + k + \" rebuild the secret.\"));\n  if(res.setId){\n    sum.appendChild(document.createTextNode(\" Set \"));\n    sum.appendChild(el(\"code\", null, res.setId));\n    sum.appendChild(document.createTextNode(\".\"));\n  } else {\n    sum.appendChild(document.createTextNode(\" Plain format: these shares carry no checks.\"));\n  }\n  $(\"cautionText\").textContent = \"Put each share somewhere different. Anyone holding \" + k + \" shares has the secret. Copy all puts every share on the clipboard together. Paste them somewhere temporary, separate them at once, then press Empty clipboard.\";\n}\nvar splitHost = { box: $(\"splitFallback\"), area: $(\"splitFallbackText\") };\n\n$(\"btnSplit\").addEventListener(\"click\", function(){\n  if(splitState === \"working\") return;\n  $(\"splitMsg\").textContent = \"\"; $(\"splitMsg\").className = \"msg\"; $(\"splitMsg\").setAttribute(\"role\", \"status\");\n  var s = readSecret();\n  if(s.err){ showSplitError(s.err); return; }\n  var ver = inputVer, cver = clearVer;\n  var n = numVal(\"nShares\"), k = numVal(\"kNeeded\"), opts = splitOptions();\n  splitState = \"working\";\n  var btn = $(\"btnSplit\"); btn.disabled = true; btn.classList.add(\"working\");\n  setIcon(btn, \"refresh\", \"Splitting...\");\n  wipeSplitResult(); splitState = \"working\";\n  $(\"splitMsg\").textContent = \"Working...\";\n  frame(function(){\n    var bytes = s.bytes, copy = bytes.slice();\n    try {\n      var res = C.split(bytes, n, k, opts);\n      /* self check: rebuild from the first k shares and compare */\n      var back = C.combine(res.shares.slice(0, k));\n      var good = eqBytes(back.secret, copy);\n      C.wipe(back.secret);\n      if(!good){ throw new Error(\"selfcheck\"); }\n      if(cver !== clearVer){ splitState = \"idle\"; $(\"splitMsg\").textContent = \"\"; }\n      else {\n        renderShares(res, k);\n        $(\"splitResult\").hidden = false;\n        splitState = \"done\";\n        $(\"splitMsg\").textContent = \"\";\n        if(ver !== inputVer) markStale();\n        else $(\"splitResultTitle\").focus();\n      }\n    } catch(e){\n      wipeSplitResult();\n      showSplitError(e && e.code ? errOf(e) : \"The self check failed, so these shares were discarded. Try again.\");\n    } finally {\n      C.wipe(bytes); C.wipe(copy);\n      btn.classList.remove(\"working\");\n      setIcon(btn, \"scissors\", \"Split\");\n      updateSplitButton();\n    }\n  });\n});\n\n$(\"btnCopyAll\").addEventListener(\"click\", function(){\n  copyText(shareTexts.join(\"\\n\"), \"Copied \" + plural(shareTexts.length, \"share\", \"shares\"), splitHost);\n});\n$(\"btnClearClip\").addEventListener(\"click\", function(){\n  if(navigator.clipboard && navigator.clipboard.writeText){\n    navigator.clipboard.writeText(\"\").then(function(){ toast(\"Clipboard emptied\"); },\n      function(){ toast(\"Clipboard could not be emptied\"); });\n  } else { toast(\"Clipboard could not be emptied\"); }\n});\n$(\"btnCheck\").addEventListener(\"click\", function(){\n  var m = $(\"checkMsg\"); m.className = \"msg\"; m.textContent = \"Checking...\";\n  var k = splitK;\n  var s = readSecret();\n  frame(function(){\n    try {\n      if(s.err) throw new Error(\"x\");\n      var idx = shareTexts.map(function(_, i){ return i; });\n      var r = new Uint8Array(idx.length); crypto.getRandomValues(r);\n      idx.sort(function(a, b){ return r[a] - r[b]; });\n      var pick = idx.slice(0, k).map(function(i){ return shareTexts[i]; });\n      var res = C.combine(pick);\n      var same = eqBytes(res.secret, s.bytes);\n      C.wipe(res.secret);\n      if(same){ m.textContent = plural(k, \"share\", \"shares\") + \" rebuilt the secret.\"; m.className = \"msg ok\"; }\n      else { m.textContent = \"These shares did not rebuild the secret you entered. Do not use them.\"; m.className = \"msg err\"; }\n    } catch(e){\n      m.textContent = e && e.code ? errOf(e) : \"The check could not run. Split again.\";\n      m.className = \"msg err\";\n    } finally { if(s.bytes) C.wipe(s.bytes); }\n  });\n});\n\n/* ================= COMBINE ================= */\nvar combined = null;   // { secret: Uint8Array, text: string|null, res }\nvar lastTokens = [];\n\nfunction plainThreshold(){\n  var v = $(\"cThr\").value.trim();\n  if(v === \"\") return { value: undefined };\n  var n = Number(v);\n  if(Number.isInteger(n) && n >= 2 && n <= 255) return { value: n };\n  return { bad: true };\n}\nfunction setStatus(kind, text){\n  var s = $(\"cStatus\");\n  s.className = \"status \" + kind;\n  s.innerHTML = icon(kind === \"ready\" ? \"ok\" : kind === \"bad\" ? \"alert\" : \"info\");\n  s.appendChild(el(\"span\", null, text));\n  $(\"shares\").setAttribute(\"aria-invalid\", String(kind === \"bad\"));\n}\n\nvar ZERO_WIDTH = /[\\u200B\\u200C\\u200D\\uFEFF\\u2060]/g;\nvar ROW_CAP = 300;\nvar combineVer = 0;        // bumped on every Combine input\nvar lastValid = [];        // tokens that parsed, in input order\nvar PRIORITY = [\"MIXED_FORMATS\", \"MIXED_SETS\", \"LENGTH_MISMATCH\", \"DUPLICATE_X\"];\n\n/* An unparsed entry that looks like a damaged share gets its specific message. */\nfunction looksLikeShare(raw){\n  return /ss1/i.test(raw) || (raw.length >= 20 && /[0-9a-f]{12}/i.test(raw));\n}\n\nfunction refreshCombine(){\n  var text = $(\"shares\").value.replace(ZERO_WIDTH, \"\");\n  var tokens = C.parseShares(text);\n  lastTokens = tokens;\n  var valid = [];\n  for(var q = 0; q < tokens.length; q++) if(tokens[q].share) valid.push(tokens[q]);\n  lastValid = valid;\n  var ignored = tokens.length - valid.length;\n  var list = $(\"parsedList\"); list.textContent = \"\";\n  var thr = plainThreshold();\n  var btn = $(\"btnCombine\");\n  btn.disabled = true;\n  $(\"cThr\").setAttribute(\"aria-invalid\", String(!!thr.bad));\n  if(!tokens.length){\n    $(\"plainThr\").hidden = true;\n    setStatus(\"idle\", \"Paste at least two shares.\");\n    return;\n  }\n  var shares = valid.map(function(t){ return t.share; });\n  var st = C.validateShares(shares, thr.value != null ? { threshold: thr.value } : undefined);\n\n  /* the problem code every flagged row and the status line agree on */\n  var top = null, byCode = {};\n  st.problems.forEach(function(p){ byCode[p.code] = p.indices; });\n  for(var pi = 0; pi < PRIORITY.length; pi++) if(byCode[PRIORITY[pi]]){ top = PRIORITY[pi]; break; }\n  var flagged = {}, minorityCode = null;\n  if(top === \"MIXED_FORMATS\"){\n    var nSs = 0, nPl = 0;\n    shares.forEach(function(sh){ if(sh.format === \"ss1\") nSs++; else nPl++; });\n    if(nSs !== nPl){\n      var minor = nSs < nPl ? \"ss1\" : \"plain\";\n      minorityCode = minor === \"ss1\" ? \"TYPO_MINOR_SANCTUM\" : \"TYPO_MINOR_PLAIN\";\n      shares.forEach(function(sh, i){ if(sh.format === minor) flagged[i] = true; });\n    }\n  } else if(top){\n    byCode[top].forEach(function(i){ flagged[i] = true; });\n  }\n\n  var setIds = [], seenSet = {}, anyPlain = false;\n  shares.forEach(function(sh){\n    if(sh.format === \"plain\") anyPlain = true;\n    if(sh.setId && !seenSet[sh.setId]){ seenSet[sh.setId] = true; setIds.push(sh.setId); }\n  });\n  var dupX = null;\n  if(top === \"DUPLICATE_X\"){ var di = byCode.DUPLICATE_X[0]; dupX = shares[di].x; }\n\n  var vi = 0, seen = {};\n  var rendered = Math.min(tokens.length, ROW_CAP);\n  for(var ti = 0; ti < rendered; ti++){\n    var t = tokens[ti];\n    var li = el(\"li\");\n    if(t.share){\n      var sh = t.share, myIdx = vi++;\n      var key = sh.format + \"|\" + (sh.setId || \"\") + \"|\" + C.toHex(sh.body);\n      var dupe = seen[key]; seen[key] = true;\n      var isBad = !dupe && flagged[myIdx];\n      li.className = dupe ? \"note\" : (isBad ? \"bad\" : \"ok\");\n      li.innerHTML = icon(dupe ? \"info\" : isBad ? \"x\" : \"ok\");\n      li.appendChild(el(\"span\", \"who\", \"Share \" + sh.x));\n      li.appendChild(document.createTextNode(\" \"));\n      if(sh.setId){ li.appendChild(el(\"span\", \"sid\", \"set \" + sh.setId)); li.appendChild(document.createTextNode(\" \")); }\n      var msg = dupe ? \"same as a share above, ignored\"\n        : isBad ? errText(minorityCode || top, { x: sh.x }, { setIds: setIds })\n        : \"ok\";\n      li.appendChild(el(\"span\", dupe || isBad ? null : \"muted\", msg));\n    } else {\n      var likely = looksLikeShare(t.raw);\n      li.className = likely ? \"bad\" : \"note\";\n      li.innerHTML = icon(likely ? \"x\" : \"info\");\n      li.appendChild(el(\"span\", \"who\", \"Entry \" + (t.index + 1)));\n      li.appendChild(document.createTextNode(\" \"));\n      li.appendChild(el(\"span\", null, likely ? errText(t.error.code, {}, { onShare: true }) + \" It is ignored.\" : \"Not a share, ignored\"));\n    }\n    list.appendChild(li);\n  }\n  if(tokens.length > rendered){\n    var more = el(\"li\", \"note\");\n    more.innerHTML = icon(\"info\");\n    more.appendChild(el(\"span\", null, \"and \" + (tokens.length - rendered) + \" more entries not shown\"));\n    list.appendChild(more);\n  }\n\n  $(\"plainThr\").hidden = !(anyPlain || st.format === \"plain\" || st.format === \"mixed\");\n  var junkNote = ignored ? \" \" + (ignored === 1 ? \"1 entry was not recognised and is ignored.\" : ignored + \" entries were not recognised and are ignored.\") : \"\";\n  var dupNote = st.ignoredDuplicates ? \" \" + plural(st.ignoredDuplicates, \"repeated share\", \"repeated shares\") + \" ignored.\" : \"\";\n  if(thr.bad){\n    setStatus(\"bad\", errText(\"BAD_OPTION\", { option: \"threshold\" }));\n    return;\n  }\n  if(st.count === 0){\n    setStatus(\"idle\", \"No shares recognised yet.\" + junkNote);\n    return;\n  }\n  if(top){\n    setStatus(\"bad\", errText(top, { x: dupX }, { setIds: setIds }) + dupNote + junkNote);\n    return;\n  }\n  if(st.format === \"plain\" && thr.value == null){\n    if(st.count < 2) setStatus(\"idle\", \"1 valid share. Paste at least two.\" + dupNote + junkNote);\n    else { setStatus(\"ready\", plural(st.count, \"share\", \"shares\") + \" pasted. Plain shares do not say how many are needed, so all of them will be used.\" + dupNote + junkNote); btn.disabled = false; }\n    return;\n  }\n  if(st.missing > 0){\n    setStatus(\"idle\", st.count + \" of \" + st.needed + \" needed. Add \" + st.missing + \" more.\" + dupNote + junkNote);\n    return;\n  }\n  setStatus(\"ready\", st.count + \" of \" + st.needed + \" needed. Ready.\" + dupNote + junkNote);\n  btn.disabled = false;\n}\n\nfunction wipeCombined(){\n  if(combined){ C.wipe(combined.secret); combined = null; }\n  $(\"cOut\").textContent = \"\";\n  $(\"combineResult\").hidden = true;\n  $(\"cVerdict\").textContent = \"\"; $(\"cWarnings\").textContent = \"\";\n  $(\"cHash\").textContent = \"Show the secret to see this value.\";\n  $(\"combineFallback\").hidden = true; $(\"combineFallbackText\").value = \"\";\n}\nfunction onSharesInput(){\n  combineVer++;\n  wipeCombined();\n  $(\"combineErr\").hidden = true;\n  refreshCombine();\n  bumpIdle();\n}\n$(\"shares\").addEventListener(\"input\", onSharesInput);\n$(\"cThr\").addEventListener(\"input\", onSharesInput);\n\n$(\"btnCClear\").addEventListener(\"click\", function(){\n  combineVer++;\n  $(\"shares\").value = \"\"; $(\"cThr\").value = \"\";\n  wipeCombined(); $(\"combineErr\").hidden = true; refreshCombine();\n  combineShown = false; $(\"cHashBox\").open = false;\n  $(\"shares\").focus(); toast(\"Cleared\");\n});\n$(\"cWipe\").addEventListener(\"click\", function(){\n  combineVer++;\n  wipeCombined(); combineShown = false; $(\"cHashBox\").open = false;\n  $(\"shares\").focus(); toast(\"Cleared\");\n});\n\n$(\"btnCombine\").addEventListener(\"click\", function(){\n  var btn = $(\"btnCombine\");\n  var thr = plainThreshold();\n  if(thr.bad) return;\n  wipeCombined(); $(\"combineErr\").hidden = true;\n  btn.disabled = true; btn.classList.add(\"working\"); setIcon(btn, \"refresh\", \"Combining...\");\n  var vtokens = lastValid, ver = combineVer;\n  var inputs = vtokens.map(function(t){ return t.share; });\n  frame(function(){\n    try {\n      var res = C.combine(inputs, thr.value != null ? { threshold: thr.value } : undefined);\n      if(ver !== combineVer){ C.wipe(res.secret); }\n      else showCombined(res, vtokens);\n    } catch(e){\n      if(ver === combineVer){\n        var st = C.validateShares(inputs);\n        $(\"combineErrText\").textContent = errOf(e, { tokens: vtokens, need: st && st.needed ? st.needed : null });\n        $(\"combineErr\").hidden = false;\n      }\n    } finally {\n      btn.classList.remove(\"working\"); setIcon(btn, \"combine\", \"Combine\");\n      refreshCombine();\n    }\n  });\n});\n\nfunction showCombined(res, tokens){\n  var text = C.utf8Decode(res.secret);\n  combined = { secret: res.secret, text: text, res: res };\n  combineShown = false;\n  viewMode = text === null ? \"hex\" : \"text\";\n  var v = $(\"cVerdict\"); v.textContent = \"\";\n  var line = el(\"p\", \"okline\");\n  if(res.format === \"ss1\" && res.verified){\n    line.innerHTML = icon(\"ok\");\n    line.appendChild(el(\"span\", null, \"The shares belong to one set and agree with each other.\"));\n    v.appendChild(line);\n    v.appendChild(el(\"p\", \"hint\", \"This does not prove the secret is the original. If you recorded the SHA-256 when you split, compare it below. That is the stronger check.\"));\n  } else {\n    line.className = \"okline neutral\";\n    line.innerHTML = icon(\"info\");\n    line.appendChild(el(\"span\", null, \"These shares carry no check value. If you have the SHA-256 from when you split, compare it below. That is the stronger check.\"));\n    v.appendChild(line);\n  }\n  var w = $(\"cWarnings\"); w.textContent = \"\";\n  (res.warnings || []).forEach(function(wn){\n    if(wn.code !== \"EXTRA_SHARE_MISMATCH\") return;\n    var xs = wn.inputIndices.map(function(i){ var t = tokens[i]; return t && t.share ? t.share.x : (i + 1); });\n    var p = el(\"p\", \"okline warn\");\n    p.innerHTML = icon(\"alert\");\n    p.appendChild(el(\"span\", null, (xs.length > 1 ? \"Shares \" : \"Share \") + xs.join(\", \") + (xs.length > 1 ? \" do not match the others. \" : \" does not match the others. \") +\n      \"The secret was rebuilt from \" + plural(res.sharesUsed, \"share\", \"shares\") + \". Replace \" + (xs.length > 1 ? \"those shares.\" : \"that share.\")));\n    w.appendChild(p);\n  });\n  var note = $(\"cViewNote\");\n  note.hidden = text !== null;\n  note.textContent = text === null ? \"This is not valid text, so it is shown as hex.\" : \"\";\n  $(\"viewText\").disabled = text === null;\n  $(\"combineResult\").hidden = false;\n  applyCombineView();\n  $(\"combineResultTitle\").focus();\n}\nfunction currentView(){\n  if(!combined) return \"\";\n  return viewMode === \"text\" && combined.text !== null ? combined.text : C.toHex(combined.secret);\n}\nfunction applyCombineView(){\n  $(\"cToggle\").setAttribute(\"aria-pressed\", String(combineShown));\n  setIcon($(\"cToggle\"), combineShown ? \"eye-off\" : \"eye\", combineShown ? \"Hide\" : \"Show\");\n  $(\"viewText\").setAttribute(\"aria-pressed\", String(viewMode === \"text\"));\n  $(\"viewHex\").setAttribute(\"aria-pressed\", String(viewMode === \"hex\"));\n  $(\"cBox\").classList.toggle(\"shown\", combineShown);\n  $(\"cOut\").setAttribute(\"aria-label\", combineShown ? \"Rebuilt secret\" : \"Rebuilt secret, hidden\");\n  if(!combined){ $(\"cOut\").textContent = \"\"; return; }\n  var n = combined.secret.length;\n  $(\"cMeta\").textContent = plural(n, \"byte\", \"bytes\");\n  $(\"cOut\").textContent = combineShown ? currentView() : new Array(Math.min(n, 40) + 1).join(\"•\");\n  refreshCombineHash();\n}\nfunction refreshCombineHash(){\n  if(!$(\"cHashBox\").open) return;\n  var out = $(\"cHash\");\n  if(!combined || !combineShown){ out.textContent = \"Show the secret to see this value.\"; return; }\n  out.textContent = C.toHex(C.sha256(combined.secret));\n}\n$(\"cHashBox\").addEventListener(\"toggle\", refreshCombineHash);\n$(\"cToggle\").addEventListener(\"click\", function(){ combineShown = !combineShown; applyCombineView(); bumpIdle(); });\n$(\"viewText\").addEventListener(\"click\", function(){ if(combined && combined.text !== null){ viewMode = \"text\"; applyCombineView(); } });\n$(\"viewHex\").addEventListener(\"click\", function(){ viewMode = \"hex\"; applyCombineView(); });\n$(\"cCopy\").addEventListener(\"click\", function(){\n  if(!combined) return;\n  copyText(currentView(), \"Copied the secret\", { box: $(\"combineFallback\"), area: $(\"combineFallbackText\") });\n});\n\n/* ---------- start ---------- */\napplySplitMask(); applyCombineView();\nupdateSplitButton(); updateSentence(); updateLabelState(); updatePadState(); refreshCombine();\n})();\n</script>\n</body>\n</html>\n","signature":{"payload":"eyJzY2hlbWEiOjEsImFwcF9pZCI6InNoLmVuaWdtYS5zaGFtaXIiLCJuYW1lIjoiU2hhbWlyIFNlY3JldCBTaGFyaW5nIiwidmVyc2lvbiI6IjEuMC4yIiwiY2hlY2tzdW0iOiJzaGEyNTY6MTYwMWU3MDZiMTY4OGZlNTk4NjQ3NDQzMjc5MzRiOGNjNmNjMDM2YjNmY2NjMGFkZGE5MjBiMWQxNDZiYmY5NCIsImRlY2xhcmVkIjpbXSwiaXNzdWVkX2F0IjoxNzkwOTAwOTAxfQ","sig":"E8rJPnnnjZc4XsrL1tE_SBi0skVCuEnlFV2H8kg7L2S0THsX7yBmSLeavJGVu_DOS_IwpGmwg1q0Oa7khve4AA","keyid":"ed25519:2daedA0n4NSI2p2McCqLBfGiKRmR5XCm8lypbQTT6hg","chain":[{"payload":"eyJzY2hlbWEiOjEsInN1YmplY3QiOiJlZDI1NTE5OjJkYWVkQTBuNE5TSTJwMk1jQ3FMQmZHaUtSbVI1WENtOGx5cGJRVFQ2aGciLCJuYW1lIjoiRW5pZ21hIFRlY2hub2xvZ2llcyBTb2x1dGlvbnMiLCJub3RfYmVmb3JlIjoxNzkwNzk0NDE5LCJub3RfYWZ0ZXIiOjE4NTM5NTI4MTYsInNjb3BlIjpbInNoLmVuaWdtYS4iXX0","sig":"-lytziD13TmzrLBjPz4mtYu