{"format":"sanctum-bundle/1","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\">\n<meta name=\"referrer\" content=\"no-referrer\">\n<meta name=\"theme-color\" content=\"#0a0a0a\">\n<title>Enigma Shamir for Sanctum</title>\n<meta name=\"description\" content=\"Split a secret into shares and combine them back. Runs offline and asks for no access.\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='32' height='32'%3E%3Crect width='32' height='32' rx='6' fill='%230A0A0A'/%3E%3Crect x='3' y='3' width='26' height='26' rx='5' fill='none' stroke='%23FBFF00' stroke-width='1.5'/%3E%3Ctext x='16' y='20.5' text-anchor='middle' font-family='Poppins,Helvetica,Arial,sans-serif' font-size='10' font-weight='700' fill='%23FFFFFF' letter-spacing='-0.3'%3Esss%3C/text%3E%3C/svg%3E\">\n<style>\n  :root{\n    --ink:#000000; --ink-soft:#0a0a0a; --panel:#111111; --paper:#FFFFFF; --volt:#FBFF00;\n    --ash:#8A8A8A; --ash-soft:#5E5E5E; --line:rgba(255,255,255,.12); --line-strong:rgba(255,255,255,.24); --field:rgba(255,255,255,.5);\n    --danger:#FF5A4E; --ok:#7CFF8A;\n    --display:'Poppins',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;\n    --body:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;\n    --mono:'Space Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;\n    --gap:clamp(16px,4vw,48px);\n    color-scheme:dark;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;background:#0A0A0A;color:var(--paper)}\n  body{font-family:var(--body);font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;min-height:100vh;\n    padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}\n  [hidden]{display:none!important}\n  a{color:inherit}\n  code{font-family:var(--mono);font-size:.92em}\n  .wrap{max-width:980px;margin:0 auto;padding:0 var(--gap)}\n  .i{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n\n  /* header */\n  header.bar{position:sticky;top:0;z-index:40;background:rgba(0,0,0,.88);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\n  .bar-in{display:flex;align-items:center;gap:16px;min-height:60px;padding-block:8px}\n  .mark{display:flex;align-items:center;gap:12px}\n  .ets-badge{display:inline-flex;align-items:center;justify-content:center;width:42px;height:28px;background:var(--paper);border-radius:0}\n  .ets{font-family:var(--body);font-weight:800;font-size:13px;color:#000;letter-spacing:.01em;line-height:1}\n  .wordmark{font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase}\n  .wordmark b{color:var(--ash);font-weight:400}\n\n  /* hero */\n  .hero{padding:clamp(36px,7vw,80px) 0 clamp(24px,4vw,40px)}\n  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--ash);margin:0 0 18px}\n  h1{font-family:var(--display);font-weight:800;font-size:clamp(38px,8.5vw,88px);line-height:.95;letter-spacing:-.02em;margin:0}\n  .dash{display:inline-block;width:.46em;height:.13em;background:var(--volt);vertical-align:.3em;margin:0 .04em;border-radius:0}\n  .lede{max-width:640px;margin:24px 0 0;font-size:16px}\n  .lede span{color:var(--ash)}\n\n  .banner{border:1px solid var(--line-strong);color:var(--ash);padding:12px 16px;margin:0 0 16px;font-size:13px;display:flex;gap:10px;align-items:flex-start}\n  .banner .i{margin-top:3px}\n  .banner.bad{border-color:var(--danger);color:var(--danger)}\n  .banner.warn{border-color:rgba(251,255,0,.5);color:var(--paper)}\n  .banner.warn .i{color:var(--paper)}\n\n  section.block{padding:clamp(24px,4vw,40px) 0;border-top:1px solid var(--line)}\n  .kicker{font-family:var(--mono);font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--ash);margin:0 0 12px;display:flex;gap:12px;align-items:center}\n  .kicker::before{content:\"\";width:28px;height:2px;background:var(--volt);border-radius:0}\n  h2{font-family:var(--display);font-weight:700;font-size:clamp(22px,3.4vw,32px);line-height:1.1;letter-spacing:-.015em;margin:0 0 6px}\n  h2:focus{outline:none}\n  h2:focus-visible{outline:2px solid var(--volt);outline-offset:4px}\n  .muted{color:var(--ash)}\n  .small{font-size:13px}\n\n  /* tabs */\n  .tabs{display:flex;border:1px solid var(--field);width:max-content;max-width:100%;margin:0 0 24px}\n  .tabs button{background:transparent;color:var(--ash);border:0;border-radius:0;padding:11px 20px;font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;display:inline-flex;gap:8px;align-items:center}\n  .tabs button:hover{color:var(--paper)}\n  .tabs button[aria-selected=\"true\"]{background:var(--volt);color:#000}\n  .tabs button + button{border-left:1px solid var(--field)}\n\n  /* cards and forms */\n  .cols{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:24px;align-items:start}\n  @media (max-width:860px){.cols{grid-template-columns:minmax(0,1fr)}}\n  .card{border:1px solid var(--line);background:var(--panel);padding:clamp(16px,3vw,28px);min-width:0;margin:0 0 24px}\n  .cols .card{margin:0}\n  .card h3{font-family:var(--display);font-weight:600;font-size:18px;letter-spacing:-.01em;margin:0 0 14px}\n  label.f{display:block;margin:0 0 14px}\n  .lab{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ash);margin-bottom:6px}\n  input[type=text],input[type=number],select,textarea{\n    width:100%;background:#000;color:var(--paper);border:1px solid var(--field);border-radius:0;\n    padding:10px 12px;font:inherit;font-size:14px;outline:none}\n  textarea{font-family:var(--mono);font-size:13px;resize:vertical;line-height:1.5;min-height:92px}\n  #secret{min-height:150px}\n  @media (max-width:860px){.seg button{min-height:40px}}\n  input:focus,select:focus,textarea:focus{border-color:var(--volt);box-shadow:0 0 0 1px var(--volt)}\n  input[aria-invalid=\"true\"],textarea[aria-invalid=\"true\"]{border-color:var(--danger)}\n  .masked{-webkit-text-security:disc;text-security:disc}\n  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n  .row.end{justify-content:space-between}\n  .pair{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n  @media (max-width:420px){.pair{grid-template-columns:1fr}}\n  button{font-family:var(--body)}\n  button.btn{background:var(--volt);color:#000;border:1px solid var(--volt);border-radius:0;padding:10px 16px;font-weight:700;\n    font-size:12px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;display:inline-flex;gap:8px;align-items:center;justify-content:center;line-height:1.2}\n  button.btn:hover:not(:disabled){background:#fff;border-color:#fff}\n  button.btn:disabled{opacity:.4;cursor:not-allowed}\n  button.ghost{background:transparent;color:var(--paper);border:1px solid var(--field)}\n  button.btn:disabled,button.ghost:disabled{background:transparent;color:var(--ash);border-color:var(--line-strong);opacity:1}\n  button.ghost:hover:not(:disabled){border-color:var(--volt);color:var(--paper);background:rgba(251,255,0,.08)}\n  button.sm{padding:6px 10px;font-size:11px}\n  button:focus-visible,summary:focus-visible,.tabs button:focus-visible{outline:2px solid var(--volt);outline-offset:2px}\n  .seg{display:inline-flex;border:1px solid var(--field)}\n  .seg button{background:transparent;color:var(--ash);border:0;border-radius:0;padding:0 14px;min-height:34px;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}\n  .seg button + button{border-left:1px solid var(--field)}\n  .seg button[aria-pressed=\"true\"]{background:var(--paper);color:#000}\n  details{border:1px solid var(--line);padding:10px 12px;margin:0 0 14px}\n  details summary{padding:6px 0;cursor:pointer;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ash)}\n  details[open] > summary{margin-bottom:12px;color:var(--paper)}\n  details.how{padding:14px 16px}\n  details.how ul{margin:0;padding-left:20px;color:var(--ash);font-size:14px}\n  details.how li{margin:0 0 10px}\n  details.how li b{color:var(--paper);font-weight:600}\n  .hint{font-size:12.5px;color:var(--ash);margin:6px 0 14px}\n  .hint.err,.msg.err{color:var(--danger)}\n  .msg{min-height:1.5em;margin:10px 0 0;font-size:13px}\n  .msg.ok{color:var(--ok)}\n  .count{font-family:var(--mono);font-size:12px;color:var(--ash)}\n  .count.err{color:var(--danger)}\n  .radio{display:flex;gap:10px;align-items:flex-start;margin:0 0 10px;font-size:14px}\n  .radio input{margin-top:5px;accent-color:var(--volt)}\n  .radio small{display:block;color:var(--ash);font-size:12.5px}\n  .sentence{font-size:14px;margin:2px 0 14px}\n  .sentence b{font-family:var(--mono);color:var(--paper);font-weight:700}\n  .softwarn{font-size:12.5px;color:var(--paper);display:flex;gap:8px;align-items:flex-start;margin:0 0 10px}\n  .softwarn .i{color:var(--paper);margin-top:3px}\n\n  /* results */\n  .result.stale .sharelist,.result.stale .sumline{opacity:.4}\n  .sumline{font-size:15px;margin:0 0 16px}\n  .sumline code{color:var(--paper);font-weight:700}\n  ol.sharelist{list-style:none;margin:0 0 16px;padding:0;display:grid;gap:10px}\n  .share{border:1px solid var(--line-strong);background:#000;padding:10px 12px}\n  .share-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:6px}\n  .share-n{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ash)}\n  .share-text,.out{font-family:var(--mono);font-size:12.5px;line-height:1.5;overflow-wrap:anywhere;word-break:break-all;user-select:all;-webkit-user-select:all;margin:0;white-space:pre-wrap}\n  .caution{border:1px solid rgba(251,255,0,.5);padding:12px 14px;font-size:13px;margin:16px 0 0;display:flex;gap:10px;align-items:flex-start}\n  .caution .i{color:var(--paper);margin-top:3px}\n  .fallback{margin-top:14px}\n  .okline{display:flex;gap:10px;align-items:flex-start;margin:0 0 6px;font-weight:600}\n  .okline .i{color:var(--ok);width:20px;height:20px;margin-top:2px}\n  .okline.neutral .i{color:var(--ash)}\n  .okline.warn .i{color:var(--paper)}\n  .secretbox{border:1px solid var(--line-strong);background:#000;padding:12px 14px;margin:14px 0 10px;min-height:48px}\n  .secretbox .out{user-select:none;-webkit-user-select:none}\n  .secretbox.shown .out{user-select:all;-webkit-user-select:all}\n  .hash{font-family:var(--mono);font-size:12px;color:var(--paper);overflow-wrap:anywhere;word-break:break-all;margin:0 0 8px}\n\n  /* share list on combine */\n  ul.parsed{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:6px}\n  ul.parsed li{display:flex;gap:10px;align-items:flex-start;font-size:13px;border-left:2px solid var(--line-strong);padding:4px 0 4px 10px}\n  ul.parsed li .i{margin-top:3px}\n  ul.parsed li.ok{border-left-color:var(--ok)}\n  ul.parsed li.ok .i{color:var(--ok)}\n  ul.parsed li.bad{border-left-color:var(--danger)}\n  ul.parsed li.bad .i{color:var(--danger)}\n  ul.parsed li.note{border-left-color:var(--ash-soft);color:var(--ash)}\n  ul.parsed li.note .i{color:var(--ash)}\n  ul.parsed .who{font-family:var(--mono);font-size:12px;letter-spacing:.06em;white-space:nowrap}\n  ul.parsed .sid{font-family:var(--mono);font-size:12px;color:var(--ash)}\n  .status{display:flex;gap:10px;align-items:flex-start;font-size:14px;margin:14px 0}\n  .status .i{margin-top:3px}\n  .status.bad{color:var(--danger)}\n  .status.ready .i{color:var(--ok)}\n  .status.idle{color:var(--ash)}\n\n  .toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--volt);color:#000;\n    padding:10px 16px;font-family:var(--mono);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;z-index:60;max-width:calc(100vw - 32px)}\n  footer{padding:32px 0 56px;color:var(--ash);font-size:12px;border-top:1px solid var(--line)}\n  footer p{margin:0 0 8px;max-width:760px}\n  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}\n  @media (prefers-reduced-motion:no-preference){ .working .i{animation:spin 1s linear infinite} }\n  @keyframes spin{to{transform:rotate(360deg)}}\n</style>\n</head>\n<body>\n\n<!-- Icons: Lucide (ISC licence), inlined. -->\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\" focusable=\"false\">\n  <defs>\n    <symbol id=\"i-scissors\" viewBox=\"0 0 24 24\"><circle cx=\"6\" cy=\"6\" r=\"3\"/><path d=\"M8.12 8.12 12 12\"/><path d=\"M20 4 8.12 15.88\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><path d=\"M14.8 14.8 20 20\"/></symbol>\n    <symbol id=\"i-combine\" viewBox=\"0 0 24 24\"><path d=\"M10 18H5a3 3 0 0 1-3-3v-1\"/><path d=\"M14 2a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2\"/><path d=\"M20 2a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2\"/><path d=\"m7 21 3-3-3-3\"/><rect x=\"14\" y=\"14\" width=\"8\" height=\"8\" rx=\"2\"/><rect x=\"2\" y=\"2\" width=\"8\" height=\"8\" rx=\"2\"/></symbol>\n    <symbol id=\"i-copy\" viewBox=\"0 0 24 24\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"/></symbol>\n    <symbol id=\"i-eye\" viewBox=\"0 0 24 24\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></symbol>\n    <symbol id=\"i-eye-off\" viewBox=\"0 0 24 24\"><path d=\"M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49\"/><path d=\"M14.084 14.158a3 3 0 0 1-4.242-4.242\"/><path d=\"M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143\"/><path d=\"m2 2 20 20\"/></symbol>\n    <symbol id=\"i-dices\" viewBox=\"0 0 24 24\"><rect width=\"12\" height=\"12\" x=\"2\" y=\"10\" rx=\"2\" ry=\"2\"/><path d=\"m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3l-5-4.92a2.24 2.24 0 0 0-3 0L10 6\"/><path d=\"M6 18h.01\"/><path d=\"M10 14h.01\"/><path d=\"M15 6h.01\"/><path d=\"M18 9h.01\"/></symbol>\n    <symbol id=\"i-alert\" viewBox=\"0 0 24 24\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></symbol>\n    <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m15 9-6 6\"/><path d=\"m9 9 6 6\"/></symbol>\n    <symbol id=\"i-ok\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></symbol>\n    <symbol id=\"i-trash\" viewBox=\"0 0 24 24\"><path d=\"M3 6h18\"/><path d=\"M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6\"/><path d=\"M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2\"/><line x1=\"10\" x2=\"10\" y1=\"11\" y2=\"17\"/><line x1=\"14\" x2=\"14\" y1=\"11\" y2=\"17\"/></symbol>\n    <symbol id=\"i-shield\" viewBox=\"0 0 24 24\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></symbol>\n    <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4\"/><path d=\"M12 8h.01\"/></symbol>\n    <symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"/><path d=\"M8 16H3v5\"/></symbol>\n    <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"/><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"/><path d=\"m9 14 2 2 4-4\"/></symbol>\n  </defs>\n</svg>\n\n<header class=\"bar\">\n  <div class=\"wrap bar-in\">\n    <span class=\"mark\" aria-label=\"Enigma Technologies Solutions\">\n      <span class=\"ets-badge\"><span class=\"ets\">ETS</span></span>\n      <span class=\"wordmark\">Enigma <b>/ Shamir · Sanctum</b></span>\n    </span>\n  </div>\n</header>\n\n<main>\n  <section class=\"hero\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">Enigma Technologies Solutions · Secret sharing for Sanctum</p>\n      <h1>split<span class=\"dash\"></span>combine</h1>\n      <p class=\"lede\">Split a secret into shares. Any <em>k</em> of them rebuild it. <span>Fewer than the needed number reveal nothing about the secret's content; the size bucket and the needed number are visible in every share. Everything runs in this window. Nothing is stored or sent.</span></p>\n    </div>\n  </section>\n\n  <div class=\"wrap\">\n    <div class=\"banner bad\" id=\"noCrypto\" role=\"alert\" hidden>\n      <svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-alert\"/></svg>\n      <span>This window has no secure random source, so nothing can be split. Update Sanctum and try again.</span>\n    </div>\n    <div class=\"banner\" id=\"noCore\" role=\"alert\" hidden>\n      <svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-alert\"/></svg>\n      <span>The secret sharing code did not load. This file is incomplete.</span>\n    </div>\n    <div class=\"banner\">\n      <svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-info\"/></svg>\n      <span>Closing this window discards the secret, the shares and any result.</span>\n    </div>\n  </div>\n\n  <section class=\"block\" id=\"app\">\n    <div class=\"wrap\">\n      <div class=\"tabs\" role=\"tablist\" aria-label=\"Mode\">\n        <button type=\"button\" role=\"tab\" id=\"tabSplit\" aria-selected=\"true\" aria-controls=\"panelSplit\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-scissors\"/></svg>Split</button>\n        <button type=\"button\" role=\"tab\" id=\"tabCombine\" aria-selected=\"false\" aria-controls=\"panelCombine\" tabindex=\"-1\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-combine\"/></svg>Combine</button>\n      </div>\n\n      <!-- ================= SPLIT ================= -->\n      <div id=\"panelSplit\" role=\"tabpanel\" aria-labelledby=\"tabSplit\">\n        <p class=\"kicker\">01 · Split</p>\n        <h2>Turn one secret into shares</h2>\n        <p class=\"muted small\" style=\"margin:0 0 24px;max-width:640px\">Enter a secret, choose how many shares to make and how many are needed to rebuild it, then split.</p>\n\n        <div class=\"cols\">\n          <div class=\"card\">\n            <h3>Secret</h3>\n            <div class=\"row end\" style=\"margin-bottom:10px\">\n              <div class=\"seg\" role=\"group\" aria-label=\"Secret type\">\n                <button type=\"button\" id=\"modeText\" aria-pressed=\"true\">Text</button>\n                <button type=\"button\" id=\"modeHex\" aria-pressed=\"false\">Hex</button>\n              </div>\n              <span class=\"row\" style=\"gap:12px\"><span class=\"count\" id=\"sCount\">0 of 1024 bytes</span>\n              <button type=\"button\" class=\"btn ghost sm\" id=\"sClear\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-trash\"/></svg><span>Clear</span></button></span>\n            </div>\n            <label class=\"f\" for=\"secret\"><span class=\"lab\" id=\"secretLab\">Secret (text, UTF-8)</span></label>\n            <textarea id=\"secret\" class=\"masked\" rows=\"4\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\" maxlength=\"8192\" aria-describedby=\"sCount sHint sErr\" style=\"margin-top:-8px\"></textarea>\n            <p class=\"hint\" id=\"sHint\">Hidden while you type. Line breaks are kept.</p>\n            <p class=\"hint err\" id=\"sErr\" hidden></p>\n            <div class=\"row\">\n              <button type=\"button\" class=\"btn ghost sm\" id=\"sToggle\" aria-pressed=\"false\" aria-label=\"Show secret\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-eye\"/></svg><span aria-hidden=\"true\">Show</span></button>\n              <button type=\"button\" class=\"btn ghost sm\" id=\"sGen\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-dices\"/></svg><span>Generate</span></button>\n              <label class=\"row\" style=\"gap:6px;flex-wrap:nowrap\"><span class=\"lab\" style=\"margin:0\">Length</span>\n                <input type=\"number\" id=\"genLen\" value=\"32\" min=\"8\" max=\"128\" step=\"1\" style=\"width:76px;padding:6px 8px\" aria-describedby=\"genInfo\"></label>\n            </div>\n            <p class=\"hint\" id=\"genInfo\">Generate makes a random secret from 28 easy to read letters and digits. At 32 characters that is 153.8 bits.</p>\n            <details id=\"sHashBox\">\n              <summary>Check value (SHA-256)</summary>\n              <p class=\"hash\" id=\"sHash\" aria-live=\"polite\">Show the secret to see this value.</p>\n              <p class=\"hint\" style=\"margin:0\">Anyone who sees this value can test guesses against it. Do not store it next to the shares.</p>\n            </details>\n          </div>\n\n          <div class=\"card\">\n            <h3>Shares</h3>\n            <div class=\"pair\">\n              <label class=\"f\"><span class=\"lab\">Shares (n)</span>\n                <input type=\"number\" id=\"nShares\" value=\"5\" min=\"2\" max=\"255\" step=\"1\" inputmode=\"numeric\" autocomplete=\"off\" aria-describedby=\"kSentence\"></label>\n              <label class=\"f\"><span class=\"lab\">Needed (k)</span>\n                <input type=\"number\" id=\"kNeeded\" value=\"3\" min=\"2\" max=\"255\" step=\"1\" inputmode=\"numeric\" autocomplete=\"off\" aria-describedby=\"kSentence\"></label>\n            </div>\n            <p class=\"sentence\" id=\"kSentence\" aria-live=\"polite\"></p>\n            <p class=\"softwarn\" id=\"kWarn\" hidden><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-alert\"/></svg><span></span></p>\n            <label class=\"f\"><span class=\"lab\">Label (optional)</span>\n              <input type=\"text\" id=\"label\" maxlength=\"32\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" aria-describedby=\"labelHint\"></label>\n            <p class=\"hint\" id=\"labelHint\" style=\"margin-top:-8px\">Letters, digits, dot, underscore, hyphen; up to 32. Helps you tell sets apart. It is not secret and not checked.</p>\n          </div>\n          <div class=\"card\" style=\"grid-column:1/-1\">\n            <details style=\"margin:0\" id=\"optBox\">\n              <summary>Options</summary>\n              <fieldset style=\"border:0;padding:0;margin:0 0 12px\">\n                <legend class=\"lab\" style=\"padding:0\">Share format</legend>\n                <label class=\"radio\"><input type=\"radio\" name=\"fmt\" value=\"ss1\" checked><span>Sanctum (recommended)<small>Shares record how many are needed and which set they belong to. A check value catches wrong or missing shares.</small></span></label>\n                <label class=\"radio\"><input type=\"radio\" name=\"fmt\" value=\"plain\"><span>Plain, compatible with ssss-made-easy and shamir-secret-sharing<small>No checks. Wrong or too few shares give a wrong answer without a warning. Use it to exchange shares with those tools.</small></span></label>\n              </fieldset>\n              <label class=\"f\"><span class=\"lab\">Hide secret length</span>\n                <select id=\"pad\">\n                  <option value=\"0\">Off</option>\n                  <option value=\"16\">16 bytes</option>\n                  <option value=\"32\" selected>32 bytes</option>\n                  <option value=\"64\">64 bytes</option>\n                  <option value=\"128\">128 bytes</option>\n                  <option value=\"256\">256 bytes</option>\n                </select></label>\n              <p class=\"hint\" id=\"padHint\" style=\"margin:0\">Rounds the hidden data up to a multiple of this size, so a share does not show the exact length. It hides the length inside that range, not the fact that a secret exists.</p>\n            </details>\n          </div>\n        </div>\n\n        <div class=\"row\" style=\"margin:24px 0 0\">\n          <button type=\"button\" class=\"btn\" id=\"btnSplit\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-scissors\"/></svg><span>Split</span></button>\n        </div>\n        <p class=\"msg\" id=\"splitMsg\" role=\"status\" aria-live=\"polite\"></p>\n\n        <div class=\"card result\" id=\"splitResult\" hidden style=\"margin-top:16px\">\n          <h3 id=\"splitResultTitle\" tabindex=\"-1\">Shares</h3>\n          <p class=\"sumline\" id=\"splitSummary\" aria-live=\"polite\"></p>\n          <p class=\"msg err\" id=\"splitStale\" role=\"status\" hidden>Inputs changed. Split again.</p>\n          <ol class=\"sharelist\" id=\"shareList\"></ol>\n          <div class=\"row\">\n            <button type=\"button\" class=\"btn ghost\" id=\"btnCopyAll\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-copy\"/></svg><span>Copy all (one per line)</span></button>\n            <button type=\"button\" class=\"btn ghost\" id=\"btnCheck\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-refresh\"/></svg><span>Check these shares</span></button>\n            <button type=\"button\" class=\"btn ghost\" id=\"btnClearClip\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-clip\"/></svg><span>Empty clipboard</span></button>\n            <button type=\"button\" class=\"btn ghost\" id=\"btnWipeSplit\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-trash\"/></svg><span>Clear everything</span></button>\n          </div>\n          <p class=\"msg\" id=\"checkMsg\" role=\"status\" aria-live=\"polite\"></p>\n          <div class=\"caution\">\n            <svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-alert\"/></svg>\n            <span id=\"cautionText\"></span>\n          </div>\n          <div class=\"fallback\" id=\"splitFallback\" hidden>\n            <label class=\"lab\" for=\"splitFallbackText\">Copy was blocked. The text is selected; press Ctrl+C or Cmd+C.</label>\n            <textarea id=\"splitFallbackText\" readonly rows=\"4\" spellcheck=\"false\"></textarea>\n          </div>\n        </div>\n      </div>\n\n      <!-- ================= COMBINE ================= -->\n      <div id=\"panelCombine\" role=\"tabpanel\" aria-labelledby=\"tabCombine\" hidden>\n        <p class=\"kicker\">02 · Combine</p>\n        <h2>Rebuild a secret from shares</h2>\n        <p class=\"muted small\" style=\"margin:0 0 24px;max-width:640px\">Paste at least as many shares as were needed. Extra shares are fine.</p>\n\n        <div class=\"card\">\n          <label class=\"f\" for=\"shares\"><span class=\"lab\">Paste shares, one per line</span></label>\n          <textarea id=\"shares\" rows=\"6\" maxlength=\"1000000\" aria-describedby=\"cStatus\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\" spellcheck=\"false\" placeholder=\"ops-ss1-3-0b704569-80f380b5a1c4e7d20b9f3a4d6e18c2f5-c852&#10;ops-ss1-3-0b704569-3be1d09c77f2a4185ce0b6d3912f07a8-51e0\" style=\"margin-top:-8px\"></textarea>\n          <ul class=\"parsed\" id=\"parsedList\" aria-label=\"Pasted shares\"></ul>\n          <div class=\"status idle\" id=\"cStatus\" role=\"status\" aria-live=\"polite\">\n            <svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-info\"/></svg><span>Paste at least two shares.</span>\n          </div>\n          <div id=\"plainThr\" hidden>\n            <label class=\"f\" style=\"max-width:280px\"><span class=\"lab\">How many shares were needed (optional)</span>\n              <input type=\"number\" id=\"cThr\" min=\"2\" max=\"255\" step=\"1\" inputmode=\"numeric\" autocomplete=\"off\" aria-describedby=\"cThrHint cStatus\"></label>\n            <p class=\"hint\" id=\"cThrHint\" style=\"margin-top:-8px\">Plain shares do not record this. If you fill it in, extra shares are checked against each other.</p>\n          </div>\n          <div class=\"row\">\n            <button type=\"button\" class=\"btn\" id=\"btnCombine\" disabled><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-combine\"/></svg><span>Combine</span></button>\n            <button type=\"button\" class=\"btn ghost\" id=\"btnCClear\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-trash\"/></svg><span>Clear</span></button>\n          </div>\n        </div>\n\n        <div class=\"banner bad\" id=\"combineErr\" role=\"alert\" hidden>\n          <svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-x\"/></svg>\n          <span id=\"combineErrText\"></span>\n        </div>\n\n        <div class=\"card result\" id=\"combineResult\" hidden>\n          <h3 id=\"combineResultTitle\" tabindex=\"-1\">Secret</h3>\n          <div id=\"cVerdict\"></div>\n          <div id=\"cWarnings\"></div>\n          <div class=\"secretbox\" id=\"cBox\"><pre class=\"out\" id=\"cOut\" role=\"group\" tabindex=\"0\" aria-label=\"Rebuilt secret, hidden\"></pre></div>\n          <p class=\"count\" id=\"cMeta\" style=\"margin:0 0 12px\"></p>\n          <p class=\"hint\" id=\"cViewNote\" hidden></p>\n          <div class=\"row\">\n            <button type=\"button\" class=\"btn ghost sm\" id=\"cToggle\" aria-pressed=\"false\" aria-label=\"Show secret\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-eye\"/></svg><span aria-hidden=\"true\">Show</span></button>\n            <div class=\"seg\" role=\"group\" aria-label=\"View as\">\n              <button type=\"button\" id=\"viewText\" aria-pressed=\"true\">Text</button>\n              <button type=\"button\" id=\"viewHex\" aria-pressed=\"false\">Hex</button>\n            </div>\n            <button type=\"button\" class=\"btn ghost sm\" id=\"cCopy\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-copy\"/></svg><span>Copy</span></button>\n            <button type=\"button\" class=\"btn ghost sm\" id=\"cWipe\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-trash\"/></svg><span>Clear</span></button>\n          </div>\n          <details id=\"cHashBox\" style=\"margin-top:16px\">\n            <summary>Check value (SHA-256)</summary>\n            <p class=\"hash\" id=\"cHash\" aria-live=\"polite\">Show the secret to see this value.</p>\n            <p class=\"hint\" style=\"margin:0\">Anyone who sees this value can test guesses against it. Do not store it next to the shares.</p>\n          </details>\n          <div class=\"fallback\" id=\"combineFallback\" hidden>\n            <label class=\"lab\" for=\"combineFallbackText\">Copy was blocked. The text is selected; press Ctrl+C or Cmd+C.</label>\n            <textarea id=\"combineFallbackText\" readonly rows=\"3\" spellcheck=\"false\"></textarea>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"block\">\n    <div class=\"wrap\">\n      <details class=\"how\">\n        <summary>How this works and what it does not protect</summary>\n        <ul>\n          <li><b>The scheme.</b> Shamir's secret sharing works on each byte of the secret in a field of 256 values. Any <em>k</em> shares rebuild the secret. Fewer than <em>k</em> reveal nothing about it, however much computing power they have, as long as the random numbers were good.</li>\n          <li><b>Randomness.</b> Random numbers come from this window's secure random source. If it is missing, the tool stops instead of using something weaker.</li>\n          <li><b>Two formats.</b> A Sanctum share adds the number of shares needed, a set id, a checksum on the share and a check value hidden inside the secret. The tool can then tell you when a share is mistyped, missing or from another set. These checks are not secret, so they do not prove the secret is the original. A plain share has none of this and matches ssss-made-easy and the shamir-secret-sharing package.</li>\n          <li><b>Not the ssss command line.</b> These shares do not work with the ssss-split and ssss-combine programs.</li>\n          <li><b>What it covers.</b> It protects against lost and mistyped shares. It does not protect against a dishonest share holder, malware, screen capture or another program reading the clipboard. Someone holding enough other shares can invent a share that rebuilds a secret of their choice, so the checks catch accidents, not cheating.</li>\n          <li><b>Length.</b> Every share is about as long as the secret. The length option pads the hidden data so the exact size is not visible.</li>\n          <li><b>Cleanup.</b> Nothing is stored. Clear empties the fields and the bytes this page holds, where it can. The idle timer only hides the secret again after 60 seconds without typing. Browsers may keep copies of text in memory, so treat this as best effort.</li>\n        </ul>\n      </details>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <p>Sanctum example tool, released under AGPL-3.0 with the rest of Sanctum. It asks Sanctum for no permissions.</p>\n    <p>The feature set follows ssss-made-easy by Martin Carpella and 0xjjpa (GPL-3.0). The plain format and the field arithmetic match the shamir-secret-sharing package (Apache-2.0, Privy) and HashiCorp Vault's shamir package. This file was written from a specification and contains none of their code. Icons are from Lucide (ISC).</p>\n  </div>\n</footer>\n\n<div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n\n<script>\n/*\n * Shamir secret sharing core for the Sanctum example tool.\n *\n * Plain script: no DOM, no imports, no network, no dynamic code. Synchronous.\n * It sets globalThis.ShamirCore and, under Node, module.exports.\n * The only platform dependencies are globalThis.crypto.getRandomValues,\n * TextEncoder and TextDecoder.\n *\n * Maths: Shamir's scheme over GF(256) with modulus 0x11b. The exp and log\n * tables are built at load time from the generator 3.\n * Formats and rules follow the project spec: \"ss1\" (self-describing, with a\n * check value inside the shared payload) and \"plain\" (bare shares in the\n * token-NN-hex layout used by ssss-made-easy and shamir-secret-sharing).\n *\n * Credit: the feature set follows ssss-made-easy (Martin Carpella, 0xjjpa;\n * GPL-3.0). The share layout matches shamir-secret-sharing (Apache-2.0) and\n * the HashiCorp Vault shamir package. This file was written from the spec,\n * without copying their code or tables.\n */\n(function () {\n  \"use strict\";\n\n  // ---------------------------------------------------------------- constants\n\n  var PAD_CHOICES = Object.freeze([0, 16, 32, 64, 128, 256]);\n\n  var LIMITS = Object.freeze({\n    MIN_SHARES: 2,\n    MAX_SHARES: 255,\n    MIN_THRESHOLD: 2,\n    MAX_SECRET_BYTES: 1024,\n    MAX_LABEL_CHARS: 32,\n    PAD_CHOICES: PAD_CHOICES,\n    GENERATOR_ALPHABET: \"ABCDEFGHJKMNPQRTUVWXYZ234679\",\n  });\n\n  // 1 to 32 label characters, and no dash-delimited segment equal to ss1 in any case.\n  var LABEL_PATTERN = /^(?!(?:[A-Za-z0-9._-]*-)?[Ss][Ss]1(?:-|$))[A-Za-z0-9._-]{1,32}$/;\n\n  var TAG_DOMAIN = asciiBytes(\"sanctum-shamir/v1/tag\");\n  var CHK_DOMAIN = asciiBytes(\"sanctum-shamir/v1/share\");\n\n  var MESSAGES = {\n    SECRET_EMPTY: \"The secret is empty.\",\n    SECRET_TOO_LONG: \"The secret is too long.\",\n    BAD_SHARE_COUNT: \"The number of shares must be a whole number from 2 to 255.\",\n    BAD_THRESHOLD: \"The threshold is not valid.\",\n    BAD_OPTION: \"An option is not valid.\",\n    RANDOM_UNAVAILABLE: \"No secure random source is available.\",\n    EMPTY_INPUT: \"Nothing to read.\",\n    BAD_SYNTAX: \"This does not look like a share.\",\n    BAD_HEX: \"The share has a non-hex character or an odd number of digits.\",\n    SHARE_TOO_SHORT: \"The share is too short.\",\n    X_OUT_OF_RANGE: \"The share position is out of range.\",\n    BAD_CHECKSUM: \"The share checksum does not match.\",\n    NO_SHARES: \"No shares were given.\",\n    MIXED_FORMATS: \"Shares of different formats cannot be combined.\",\n    MIXED_SETS: \"The shares come from different splits.\",\n    LENGTH_MISMATCH: \"The shares have different lengths.\",\n    DUPLICATE_X: \"Two different shares claim the same position.\",\n    NOT_ENOUGH_SHARES: \"Not enough shares.\",\n    INCONSISTENT_SHARES: \"A share does not agree with the others.\",\n    INTEGRITY_FAILED: \"The shares did not rebuild a valid secret.\",\n  };\n\n  // ------------------------------------------------------------------- errors\n\n  class ShamirError extends Error {\n    constructor(code, details, message) {\n      super(message || MESSAGES[code] || code);\n      this.name = \"ShamirError\";\n      this.code = code;\n      this.details = Object.freeze(details ? Object.assign({}, details) : {});\n    }\n  }\n\n  function fail(code, details, message) {\n    throw new ShamirError(code, details, message);\n  }\n\n  // ------------------------------------------------------------------ helpers\n\n  function asciiBytes(s) {\n    var out = new Uint8Array(s.length);\n    for (var i = 0; i < s.length; i++) out[i] = s.charCodeAt(i) & 0xff;\n    return out;\n  }\n\n  function concat(parts) {\n    var total = 0;\n    var i;\n    for (i = 0; i < parts.length; i++) total += parts[i].length;\n    var out = new Uint8Array(total);\n    var pos = 0;\n    for (i = 0; i < parts.length; i++) {\n      out.set(parts[i], pos);\n      pos += parts[i].length;\n    }\n    return out;\n  }\n\n  var HEX_CHARS = \"0123456789abcdef\";\n  var HEX_PAIRS = (function () {\n    var t = new Array(256);\n    for (var i = 0; i < 256; i++) t[i] = HEX_CHARS[i >> 4] + HEX_CHARS[i & 15];\n    return t;\n  })();\n\n  function toHex(bytes) {\n    var parts = new Array(bytes.length);\n    for (var i = 0; i < bytes.length; i++) parts[i] = HEX_PAIRS[bytes[i]];\n    return parts.join(\"\");\n  }\n\n  function hexValue(c) {\n    if (c >= 48 && c <= 57) return c - 48;\n    if (c >= 97 && c <= 102) return c - 87;\n    if (c >= 65 && c <= 70) return c - 55;\n    return -1;\n  }\n\n  function fromHex(hex) {\n    if (typeof hex !== \"string\") fail(\"BAD_HEX\", { reason: \"not a string\" });\n    if (hex.length % 2 !== 0) fail(\"BAD_HEX\", { reason: \"odd length\" });\n    var out = new Uint8Array(hex.length / 2);\n    for (var i = 0; i < out.length; i++) {\n      var hi = hexValue(hex.charCodeAt(2 * i));\n      var lo = hexValue(hex.charCodeAt(2 * i + 1));\n      if (hi < 0 || lo < 0) fail(\"BAD_HEX\", { reason: \"non-hex character\", position: 2 * i });\n      out[i] = (hi << 4) | lo;\n    }\n    return out;\n  }\n\n  function utf8Encode(text) {\n    return new TextEncoder().encode(text);\n  }\n\n  function utf8Decode(bytes) {\n    try {\n      return new TextDecoder(\"utf-8\", { fatal: true, ignoreBOM: true }).decode(bytes);\n    } catch (e) {\n      return null;\n    }\n  }\n\n  function isBytes(x) {\n    return x instanceof Uint8Array || Object.prototype.toString.call(x) === \"[object Uint8Array]\";\n  }\n\n  function wipe(bytes) {\n    if (bytes && typeof bytes.fill === \"function\") bytes.fill(0);\n  }\n\n  function isValidLabel(label) {\n    return typeof label === \"string\" && LABEL_PATTERN.test(label);\n  }\n\n  function entropyBits(length) {\n    return length * Math.log2(LIMITS.GENERATOR_ALPHABET.length);\n  }\n\n  // ------------------------------------------------------------------- SHA-256\n\n  var SHA_K = new Uint32Array(64);\n  var SHA_H0 = new Uint32Array(8);\n  (function () {\n    var primes = [];\n    for (var c = 2; primes.length < 64; c++) {\n      var isPrime = true;\n      for (var d = 2; d * d <= c; d++) {\n        if (c % d === 0) {\n          isPrime = false;\n          break;\n        }\n      }\n      if (isPrime) primes.push(c);\n    }\n    function frac32(v) {\n      return Math.floor((v - Math.floor(v)) * 4294967296) >>> 0;\n    }\n    var i;\n    for (i = 0; i < 64; i++) SHA_K[i] = frac32(Math.cbrt(primes[i]));\n    for (i = 0; i < 8; i++) SHA_H0[i] = frac32(Math.sqrt(primes[i]));\n  })();\n\n  function sha256(