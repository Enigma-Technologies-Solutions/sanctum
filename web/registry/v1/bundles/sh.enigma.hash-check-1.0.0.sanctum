 = h1 >>> 0, t1l = l1 >>> 0;\n      rotr64(ah, al, 28); var S0h = R[0], S0l = R[1];\n      rotr64(ah, al, 34); S0h ^= R[0]; S0l ^= R[1];\n      rotr64(ah, al, 39); S0h ^= R[0]; S0l ^= R[1];\n      var mh = (ah & bh) ^ (ah & ch_) ^ (bh & ch_);\n      var ml = (al & bl) ^ (al & cl) ^ (bl & cl);\n      var l2s = (S0l >>> 0) + (ml >>> 0);\n      var t2h = ((S0h >>> 0) + (mh >>> 0) + Math.floor(l2s / 4294967296)) >>> 0;\n      var t2l = l2s >>> 0;\n      hh = gh; hl = gl; gh = fh; gl = fl; fh = eh; fl = el;\n      var le = (dl >>> 0) + t1l;\n      eh = ((dh >>> 0) + t1h + Math.floor(le / 4294967296)) >>> 0;\n      el = le >>> 0;\n      dh = ch_; dl = cl; ch_ = bh; cl = bl; bh = ah; bl = al;\n      var la = t1l + t2l;\n      ah = (t1h + t2h + Math.floor(la / 4294967296)) >>> 0;\n      al = la >>> 0;\n    }\n    var ws = [ah, al, bh, bl, ch_, cl, dh, dl, eh, el, fh, fl, gh, gl, hh, hl];\n    for (t = 0; t < 16; t += 2) {\n      var ls = (H[t + 1] >>> 0) + (ws[t + 1] >>> 0);\n      H[t] = ((H[t] >>> 0) + (ws[t] >>> 0) + Math.floor(ls / 4294967296)) >>> 0;\n      H[t + 1] = ls >>> 0;\n    }\n  }\n\n  // ---------------------------------------------------------------- streaming\n\n  function createHasher(alg) {\n    var spec = ALGS[alg];\n    if (!spec) throw HashError(\"unknown_algorithm\", \"Unknown algorithm: \" + String(alg));\n    var wide = alg !== \"sha256\";\n    var block = wide ? 128 : 64;\n    var H = wide ? (alg === \"sha384\" ? INIT384 : INIT512).slice() : INIT256.slice();\n    var compress = wide ? compress512 : compress256;\n    var buf = new Uint8Array(block);\n    var used = 0;\n    var total = 0;\n    var done = false;\n\n    function update(data) {\n      if (done) throw HashError(\"finished\", \"This hasher already produced its digest.\");\n      if (!(data instanceof Uint8Array)) throw HashError(\"bad_input\", \"Hash input must be a Uint8Array.\");\n      var pos = 0;\n      var len = data.length;\n      total += len;\n      if (used > 0) {\n        var take = Math.min(block - used, len);\n        buf.set(data.subarray(0, take), used);\n        used += take;\n        pos = take;\n        if (used < block) return;\n        compress(H, buf, 0);\n        used = 0;\n      }\n      while (pos + block <= len) {\n        compress(H, data, pos);\n        pos += block;\n      }\n      if (pos < len) {\n        buf.set(data.subarray(pos), 0);\n        used = len - pos;\n      }\n    }\n\n    function digest() {\n      if (done) throw HashError(\"finished\", \"This hasher already produced its digest.\");\n      done = true;\n      var lenBytes = wide ? 16 : 8;\n      var padTo = block - lenBytes;\n      buf[used++] = 0x80;\n      if (used > padTo) {\n        buf.fill(0, used, block);\n        compress(H, buf, 0);\n        used = 0;\n      }\n      buf.fill(0, used, block);\n      // Message length in bits, big endian. total is exact below 2^53 bytes.\n      var bitsHi = Math.floor(total / 536870912); // total * 8 / 2^32\n      var bitsLo = ((total % 536870912) * 8) >>> 0;\n      buf[block - 8] = bitsHi >>> 24; buf[block - 7] = (bitsHi >>> 16) & 255;\n      buf[block - 6] = (bitsHi >>> 8) & 255; buf[block - 5] = bitsHi & 255;\n      buf[block - 4] = bitsLo >>> 24; buf[block - 3] = (bitsLo >>> 16) & 255;\n      buf[block - 2] = (bitsLo >>> 8) & 255; buf[block - 1] = bitsLo & 255;\n      compress(H, buf, 0);\n      var words = alg === \"sha256\" ? 8 : alg === \"sha384\" ? 12 : 16;\n      var out = new Uint8Array(words * 4);\n      for (var k = 0; k < words; k++) {\n        out[4 * k] = H[k] >>> 24; out[4 * k + 1] = (H[k] >>> 16) & 255;\n        out[4 * k + 2] = (H[k] >>> 8) & 255; out[4 * k + 3] = H[k] & 255;\n      }\n      return out;\n    }\n\n    return { alg: alg, update: update, digest: digest };\n  }\n\n  // ---------------------------------------------------------------- helpers\n\n  var HEX = \"0123456789abcdef\";\n\n  function toHex(bytes) {\n    var s = \"\";\n    for (var i = 0; i < bytes.length; i++) s += HEX[bytes[i] >>> 4] + HEX[bytes[i] & 15];\n    return s;\n  }\n\n  /** Hash a whole byte array at once. Returns lowercase hex. */\n  function hashHex(alg, bytes) {\n    var h = createHasher(alg);\n    h.update(bytes);\n    return toHex(h.digest());\n  }\n\n  function algForHexLength(n) {\n    for (var id in ALGS) if (ALGS[id].hexLength === n) return id;\n    return null;\n  }\n\n  // ---------------------------------------------------------------- reading pasted checksums\n\n  var LEGACY = { 32: \"MD5\", 40: \"SHA-1\" };\n  var TAGS = { sha256: \"sha256\", \"sha-256\": \"sha256\", sha384: \"sha384\", \"sha-384\": \"sha384\", sha512: \"sha512\", \"sha-512\": \"sha512\" };\n  var LEGACY_TAGS = { md5: \"MD5\", sha1: \"SHA-1\", \"sha-1\": \"SHA-1\" };\n  var HEX_ONLY = /^[0-9a-fA-F]+$/;\n\n  /**\n   * Read the text a person pasted. Returns { entries, unsupported, ignored }.\n   * Each entry is { hex (lowercase), alg, name }. `name` is null when the line has none.\n   * `unsupported` lists legacy sums (MD5, SHA-1) that were recognised and left out.\n   * `ignored` counts lines that were not checksums at all.\n   */\n  function parseChecksums(text) {\n    var entries = [];\n    var unsupported = [];\n    var ignored = 0;\n    var lines = String(text).split(/\\r\\n|\\r|\\n/);\n    for (var i = 0; i < lines.length; i++) {\n      var line = lines[i].trim();\n      if (line === \"\" || line[0] === \"#\") continue;\n      var m, tag, hex, name;\n\n      // BSD: SHA256 (name) = hash\n      if ((m = /^([A-Za-z0-9-]+)\\s*\\((.*)\\)\\s*=\\s*([0-9a-fA-F]+)$/.exec(line))) {\n        tag = m[1].toLowerCase(); name = m[2]; hex = m[3];\n        if (LEGACY_TAGS[tag]) { unsupported.push(LEGACY_TAGS[tag]); continue; }\n        if (TAGS[tag] && ALGS[TAGS[tag]].hexLength === hex.length) {\n          entries.push({ hex: hex.toLowerCase(), alg: TAGS[tag], name: name });\n        } else ignored++;\n        continue;\n      }\n      // Prefixed: sha256:hash (a name may follow after spaces)\n      if ((m = /^([A-Za-z0-9-]+):\\s*([0-9a-fA-F]+)(?:\\s+\\*?(.+))?$/.exec(line))) {\n        tag = m[1].toLowerCase(); hex = m[2]; name = m[3] === undefined ? null : m[3];\n        if (LEGACY_TAGS[tag]) { unsupported.push(LEGACY_TAGS[tag]); continue; }\n        if (TAGS[tag] && ALGS[TAGS[tag]].hexLength === hex.length) {\n          entries.push({ hex: hex.toLowerCase(), alg: TAGS[tag], name: name });\n        } else ignored++;\n        continue;\n      }\n      // GNU: hash  name   or   hash *name   or a bare hash\n      if ((m = /^([0-9a-fA-F]+)(?:[ \\t]+\\*?(.+))?$/.exec(line)) && (algForHexLength(m[1].length) || LEGACY[m[1].length])) {\n        hex = m[1]; name = m[2] === undefined ? null : m[2];\n        var alg = algForHexLength(hex.length);\n        if (!alg) { unsupported.push(LEGACY[hex.length]); continue; }\n        entries.push({ hex: hex.toLowerCase(), alg: alg, name: name });\n        continue;\n      }\n      // Grouped by spaces or colons: \"e3b0 c442 ...\" or \"E3:B0:...\"\n      var squeezed = line.replace(/[\\s:]/g, \"\");\n      if (HEX_ONLY.test(squeezed) && (algForHexLength(squeezed.length) || LEGACY[squeezed.length])) {\n        var alg2 = algForHexLength(squeezed.length);\n        if (!alg2) { unsupported.push(LEGACY[squeezed.length]); continue; }\n        entries.push({ hex: squeezed.toLowerCase(), alg: alg2, name: null });\n        continue;\n      }\n      ignored++;\n    }\n    return { entries: entries, unsupported: unsupported, ignored: ignored };\n  }\n\n  function baseName(n) {\n    return String(n).replace(/\\\\/g, \"/\").replace(/^\\.\\//, \"\").split(\"/\").pop();\n  }\n\n  /**\n   * Choose the entry that belongs to a file. A name match wins. With no name match, a list of\n   * one is used. A longer list is ambiguous and the person must pick the right line.\n   * Returns { entry, how } where how is \"name\", \"only\", \"ambiguous\" or \"none\".\n   */\n  function pickEntry(entries, fileName) {\n    if (entries.length === 0) return { entry: null, how: \"none\" };\n    var want = baseName(fileName);\n    var named = entries.filter(function (e) { return e.name !== null && baseName(e.name) === want; });\n    if (named.length === 1) return { entry: named[0], how: \"name\" };\n    if (named.length > 1) return { entry: null, how: \"ambiguous\" };\n    if (entries.length === 1) return { entry: entries[0], how: \"only\" };\n    return { entry: null, how: \"ambiguous\" };\n  }\n\n  /** Compare two lowercase hex strings. `different` counts positions that differ. */\n  function compareHex(a, b) {\n    if (a.length !== b.length) return { equal: false, different: Math.max(a.length, b.length) };\n    var diff = 0;\n    for (var i = 0; i < a.length; i++) if (a.charCodeAt(i) !== b.charCodeAt(i)) diff++;\n    return { equal: diff === 0, different: diff };\n  }\n\n  var api = Object.freeze({\n    ALGS: ALGS,\n    HashError: HashError,\n    createHasher: createHasher,\n    hashHex: hashHex,\n    toHex: toHex,\n    algForHexLength: algForHexLength,\n    parseChecksums: parseChecksums,\n    pickEntry: pickEntry,\n    compareHex: compareHex,\n  });\n\n  globalThis.HashCore = api;\n  if (typeof module !== \"undefined\" && module.exports) module.exports = api;\n})();\n</script>\n<script>\n(function () {\n  \"use strict\";\n  var C = globalThis.HashCore;\n  var VERSION = \"1.0.0\";\n  var CHUNK = 4 * 1024 * 1024;\n  function $(id) { return document.getElementById(id); }\n\n  $(\"ver\").textContent = VERSION;\n\n  var file = null;\n  var running = false;\n  var stop = false;\n  var chosenAlg = \"sha256\";\n  var parsed = { entries: [], unsupported: [], ignored: 0 };\n  // The last finished hash: { alg, hex, name, size }. Cleared when the file or algorithm changes.\n  var result = null;\n\n  function fmtSize(n) {\n    if (n < 1024) return n + \" bytes\";\n    var u = [\"KB\", \"MB\", \"GB\", \"TB\"], i = -1;\n    do { n /= 1024; i++; } while (n >= 1024 && i < u.length - 1);\n    return n.toFixed(n >= 100 ? 0 : 1) + \" \" + u[i];\n  }\n  function label(alg) { return C.ALGS[alg].label; }\n  function clear(node) { while (node.firstChild) node.removeChild(node.firstChild); }\n\n  // The entry that applies to the chosen file, if the pasted text has one.\n  function pick() { return C.pickEntry(parsed.entries, file ? file.name : \"\"); }\n\n  // The algorithm in force: the pasted checksum's, when it names one, else the buttons'.\n  function activeAlg() {\n    var p = pick();\n    if (p.entry) return p.entry.alg;\n    var algs = {};\n    parsed.entries.forEach(function (e) { algs[e.alg] = true; });\n    var keys = Object.keys(algs);\n    return keys.length === 1 ? keys[0] : chosenAlg;\n  }\n  function algLocked() {\n    var p = pick();\n    if (p.entry) return true;\n    var algs = {};\n    parsed.entries.forEach(function (e) { algs[e.alg] = true; });\n    return Object.keys(algs).length === 1;\n  }\n\n  function renderAlgs() {\n    var a = activeAlg(), locked = algLocked();\n    Array.prototype.forEach.call($(\"algs\").querySelectorAll(\"button\"), function (b) {\n      b.setAttribute(\"aria-pressed\", b.getAttribute(\"data-alg\") === a ? \"true\" : \"false\");\n      b.disabled = locked || running;\n    });\n    $(\"alg-note\").textContent = locked\n      ? \"Set by the pasted checksum, which is \" + (label(a)) + \" by its length.\"\n      : \"SHA-256 is what most publishers use. A pasted checksum sets this by its length.\";\n  }\n\n  function describeExpected() {\n    var note = $(\"expected-note\");\n    var text = $(\"expected\").value;\n    parsed = C.parseChecksums(text);\n    var n = parsed.entries.length;\n    var parts = [];\n    if (text.trim() === \"\") {\n      note.textContent = \"Reads a plain hash, sha256: hash, GNU lines (hash  name) and BSD lines (SHA256 (name) = hash).\";\n    } else {\n      if (n === 1) parts.push(\"Read 1 checksum (\" + label(parsed.entries[0].alg) + \").\");\n      else if (n > 1) {\n        var p = pick();\n        parts.push(\"Read \" + n + \" checksums.\" + (file\n          ? (p.how === \"name\" ? \" Using the line named \" + p.entry.name + \".\" : \" No line matches the file name, so choose the right one by pasting only that line.\")\n          : \" Choose the file and the matching line is used.\"));\n      }\n      if (parsed.unsupported.length) {\n        var kinds = parsed.unsupported.filter(function (v, i, a) { return a.indexOf(v) === i; }).join(\" and \");\n        parts.push(kinds + \" sums are not supported here, because they are no longer safe to rely on. Ask the publisher for SHA-256 or better.\");\n      }\n      if (parsed.ignored) parts.push(parsed.ignored + (parsed.ignored === 1 ? \" line was\" : \" lines were\") + \" not a checksum and was skipped.\");\n      if (!n && !parsed.unsupported.length) parts.push(\"No checksum found in this text.\");\n      note.textContent = parts.join(\" \");\n    }\n  }\n\n  function setMsg(t) { $(\"msg\").textContent = t; }\n\n  function syncControls() {\n    $(\"run\").disabled = !file || running;\n    $(\"cancel\").hidden = !running;\n    $(\"choose\").disabled = running;\n    $(\"expected\").disabled = running;\n    renderAlgs();\n  }\n\n  function hideResult() { result = null; $(\"result\").hidden = true; }\n\n  // Draw the verdict from the finished hash and the pasted text.\n  function renderResult() {\n    if (!result) return;\n    $(\"result\").hidden = false;\n    var v = $(\"verdict\"), icon = $(\"verdict-icon\").firstElementChild, title = $(\"verdict-title\"), body = $(\"verdict-body\");\n    v.className = \"verdict\";\n    $(\"computed\").textContent = result.hex;\n    $(\"out-label\").textContent = label(result.alg) + \" of the file\";\n    $(\"out-file\").textContent = result.name + \" (\" + fmtSize(result.size) + \")\";\n\n    var p = C.pickEntry(parsed.entries, result.name);\n    var same = parsed.entries.filter(function (e) { return e.alg === result.alg; });\n    var any = same.filter(function (e) { return e.hex === result.hex; });\n\n    if (p.entry && p.entry.alg === result.alg) {\n      var cmp = C.compareHex(result.hex, p.entry.hex);\n      if (cmp.equal) {\n        v.className = \"verdict ok\";\n        icon.setAttribute(\"href\", \"#i-check\");\n        title.textContent = \"Match\";\n        body.textContent = \"This file's \" + label(result.alg) + \" is the same as the checksum you pasted. That shows it is the file the checksum was made from. Make sure the checksum came from the publisher by a channel you trust.\";\n      } else {\n        v.className = \"verdict bad\";\n        icon.setAttribute(\"href\", \"#i-cross\");\n        title.textContent = \"No match. Do not use this file.\";\n        body.textContent = cmp.different + \" of \" + result.hex.length + \" characters differ. Download the file again and check it once more. If it still differs, the file is not the one the publisher meant, or the checksum belongs to a different file.\";\n      }\n      return;\n    }\n    if (any.length && !p.entry) {\n      v.className = \"verdict ok\";\n      icon.setAttribute(\"href\", \"#i-check\");\n      title.textContent = \"Match, under another name\";\n      body.textContent = \"The hash equals the line for \" + (any[0].name || \"the pasted checksum\") + \", but no line carries this file's name. Check that this is the file you meant.\";\n      return;\n    }\n    if (parsed.entries.length > 1 && !p.entry) {\n      icon.setAttribute(\"href\", \"#i-info\");\n      title.textContent = \"Could not compare\";\n      body.textContent = \"The pasted list has several lines and none is named \" + result.name + \". Paste only the line for this file.\";\n      return;\n    }\n    if (parsed.entries.length && !same.length) {\n      icon.setAttribute(\"href\", \"#i-info\");\n      title.textContent = \"Different algorithm\";\n      body.textContent = \"The pasted checksum is \" + label(parsed.entries[0].alg) + \", but this hash is \" + label(result.alg) + \". Check the file again with the algorithm that matches.\";\n      return;\n    }\n    icon.setAttribute(\"href\", \"#i-info\");\n    title.textContent = \"Nothing to compare with\";\n    body.textContent = parsed.unsupported.length\n      ? \"The pasted checksum is not one this tool supports. Compare the hash below with a SHA-256 or SHA-512 from the publisher.\"\n      : \"Compare the hash below with the one the publisher gave you, or paste that checksum in step 2.\";\n  }\n\n  async function run() {\n    if (!file || running) return;\n    var f = file;\n    var alg = activeAlg();\n    running = true; stop = false;\n    hideResult();\n    syncControls();\n    var bar = $(\"bar\");\n    bar.hidden = false; bar.value = 0; bar.max = Math.max(f.size, 1);\n    setMsg(\"Reading \" + f.name + \"...\");\n    var started = Date.now();\n    try {\n      var hasher = C.createHasher(alg);\n      for (var at = 0; at < f.size; at += CHUNK) {\n        if (stop) { setMsg(\"Stopped. Nothing was kept.\"); return; }\n        var buf = await f.slice(at, Math.min(at + CHUNK, f.size)).arrayBuffer();\n        hasher.update(new Uint8Array(buf));\n        bar.value = Math.min(at + CHUNK, f.size);\n        setMsg(fmtSize(Math.min(at + CHUNK, f.size)) + \" of \" + fmtSize(f.size) + \" read.\");\n      }\n      result = { alg: alg, hex: C.toHex(hasher.digest()), name: f.name, size: f.size };\n      var secs = ((Date.now() - started) / 1000).toFixed(1);\n      setMsg(\"Done in \" + secs + \" seconds.\");\n      renderResult();\n    } catch (e) {\n      setMsg(\"The file could not be read. It may have been moved or changed while it was open. Choose it again.\");\n    } finally {\n      running = false;\n      bar.hidden = true;\n      syncControls();\n    }\n  }\n\n  $(\"choose\").addEventListener(\"click\", function () { $(\"picker\").click(); });\n  $(\"picker\").addEventListener(\"change\", function () {\n    var f = $(\"picker\").files && $(\"picker\").files[0];\n    if (!f) return;\n    file = f;\n    hideResult();\n    setMsg(\"\");\n    var s = $(\"picked\");\n    clear(s);\n    s.classList.remove(\"muted\");\n    var b = document.createElement(\"b\");\n    b.textContent = f.name;\n    s.appendChild(b);\n    s.appendChild(document.createTextNode(\" (\" + fmtSize(f.size) + \")\"));\n    describeExpected();\n    syncControls();\n  });\n\n  $(\"expected\").addEventListener(\"input\", function () {\n    describeExpected();\n    // The verdict follows the text when the algorithm still fits; otherwise the old hash no longer applies.\n    if (result && result.alg !== activeAlg()) hideResult();\n    renderResult();\n    syncControls();\n  });\n\n  $(\"algs\").addEventListener(\"click\", function (ev) {\n    var b = ev.target.closest ? ev.target.closest(\"button[data-alg]\") : null;\n    if (!b || b.disabled) return;\n    chosenAlg = b.getAttribute(\"data-alg\");\n    hideResult();\n    renderAlgs();\n  });\n\n  $(\"run\").addEventListener(\"click\", function () { void run(); });\n  $(\"cancel\").addEventListener(\"click\", function () { stop = true; });\n\n  $(\"copy\").addEventListener(\"click\", function () {\n    var text = $(\"computed\").textContent;\n    function selectIt() {\n      var r = document.createRange();\n      r.selectNodeContents($(\"computed\"));\n      var sel = window.getSelection();\n      sel.removeAllRanges();\n      sel.addRange(r);\n      setMsg(\"Copy is blocked here. The hash is selected: press Ctrl+C or Cmd+C.\");\n    }\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(text).then(function () { setMsg(\"Hash copied.\"); }, selectIt);\n    } else selectIt();\n  });\n\n  describeExpected();\n  syncControls();\n})();\n</script>\n</body>\n</html>\n","signature":{"payload":"eyJzY2hlbWEiOjEsImFwcF9pZCI6InNoLmVuaWdtYS5oYXNoLWNoZWNrIiwibmFtZSI6Ikhhc2ggQ2hlY2siLCJ2ZXJzaW9uIjoiMS4wLjAiLCJjaGVja3N1bSI6InNoYTI1NjplN2Y2ZGRkNjM3Y2MwNzY1ODc4Y2VmNjgzYTYzMTZlZDIxNWU3ZmIxY2RkMTc4MWI0YmI2MTBiMmU1YWE4YzM1IiwiZGVjbGFyZWQiOltdLCJpc3N1ZWRfYXQiOjE3OTM2NzgwNDl9","sig":"Eco3