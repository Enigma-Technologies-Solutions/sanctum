{"format":"sanctum-bundle/1","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\">\n<meta name=\"referrer\" content=\"no-referrer\">\n<meta name=\"theme-color\" content=\"#0a0a0a\">\n<title>Enigma Hash Check for Sanctum</title>\n<meta name=\"description\" content=\"Check a downloaded file against the checksum its publisher gave you. Runs offline and asks for no access.\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='32' height='32'%3E%3Crect width='32' height='32' rx='6' fill='%230A0A0A'/%3E%3Crect x='3' y='3' width='26' height='26' rx='5' fill='none' stroke='%23FBFF00' stroke-width='1.5'/%3E%3Ctext x='16' y='20.5' text-anchor='middle' font-family='Poppins,Helvetica,Arial,sans-serif' font-size='10' font-weight='700' fill='%23FFFFFF' letter-spacing='-0.3'%3Esha%3C/text%3E%3C/svg%3E\">\n<style>\n  :root{\n    --ink:#000000; --panel:#111111; --paper:#FFFFFF; --volt:#FBFF00;\n    --ash:#8A8A8A; --line:rgba(255,255,255,.12); --line-strong:rgba(255,255,255,.24); --field:rgba(255,255,255,.5);\n    --danger:#FF5A4E; --ok:#7CFF8A;\n    --display:'Poppins',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;\n    --body:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;\n    --mono:'Space Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;\n    --gap:clamp(16px,4vw,48px);\n    color-scheme:dark;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0;background:#0A0A0A;color:var(--paper)}\n  body{font-family:var(--body);font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;min-height:100vh;\n    padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}\n  [hidden]{display:none!important}\n  code{font-family:var(--mono);font-size:.92em}\n  .wrap{max-width:980px;margin:0 auto;padding:0 var(--gap)}\n  .i{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n\n  header.bar{position:sticky;top:0;z-index:40;background:rgba(0,0,0,.88);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\n  .bar-in{display:flex;align-items:center;gap:16px;min-height:60px;padding-block:8px}\n  .mark{display:flex;align-items:center;gap:12px}\n  .ets-badge{display:inline-flex;align-items:center;justify-content:center;width:42px;height:28px;background:var(--paper)}\n  .ets{font-family:var(--body);font-weight:800;font-size:13px;color:#000;letter-spacing:.01em;line-height:1}\n  .wordmark{font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase}\n  .wordmark b{color:var(--ash);font-weight:400}\n\n  .hero{padding:clamp(36px,7vw,80px) 0 clamp(24px,4vw,40px)}\n  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--ash);margin:0 0 18px}\n  h1{font-family:var(--display);font-weight:800;font-size:clamp(38px,8.5vw,88px);line-height:.95;letter-spacing:-.02em;margin:0}\n  .dash{display:inline-block;width:.46em;height:.13em;background:var(--volt);vertical-align:.3em;margin:0 .04em}\n  .lede{max-width:640px;margin:24px 0 0;font-size:16px}\n  .lede span{color:var(--ash)}\n\n  .facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin:0 0 8px}\n  @media (max-width:760px){.facts{grid-template-columns:minmax(0,1fr)}}\n  .fact{background:var(--panel);padding:16px 18px;font-size:13.5px}\n  .fact h3{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;margin:0 0 8px;display:flex;gap:8px;align-items:center}\n  .fact p{margin:0;color:var(--ash)}\n\n  section.block{padding:clamp(24px,4vw,40px) 0;border-top:1px solid var(--line)}\n  .kicker{font-family:var(--mono);font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--ash);margin:0 0 12px;display:flex;gap:12px;align-items:center}\n  .kicker::before{content:\"\";width:28px;height:2px;background:var(--volt)}\n  h2{font-family:var(--display);font-weight:700;font-size:clamp(22px,3.4vw,32px);line-height:1.1;letter-spacing:-.015em;margin:0 0 6px}\n  .muted{color:var(--ash)}\n  .small{font-size:13px}\n\n  .lab{display:flex;justify-content:space-between;gap:10px;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ash);margin-bottom:6px}\n  textarea,input[type=text]{width:100%;background:#000;color:var(--paper);border:1px solid var(--field);border-radius:0;padding:10px 12px;font-family:var(--mono);font-size:13px;line-height:1.5;outline:none}\n  textarea{resize:vertical;min-height:96px}\n  textarea:focus,input[type=text]:focus{border-color:var(--volt);box-shadow:0 0 0 1px var(--volt)}\n  button{font-family:var(--body)}\n  button.btn{background:var(--volt);color:#000;border:1px solid var(--volt);border-radius:0;padding:10px 16px;font-weight:700;\n    font-size:12px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;display:inline-flex;gap:8px;align-items:center;justify-content:center;line-height:1.2}\n  button.btn:hover:not(:disabled){background:#fff;border-color:#fff}\n  button.ghost{background:transparent;color:var(--paper);border:1px solid var(--field)}\n  button.btn:disabled,button.ghost:disabled{background:transparent;color:var(--ash);border-color:var(--line-strong);cursor:not-allowed}\n  button.ghost:hover:not(:disabled){border-color:var(--volt);background:rgba(251,255,0,.08)}\n  button.sm{padding:6px 10px;font-size:11px}\n  button:focus-visible,input:focus-visible{outline:2px solid var(--volt);outline-offset:2px}\n  .seg{display:inline-flex;border:1px solid var(--field);flex-wrap:wrap}\n  .seg button{background:transparent;color:var(--ash);border:0;padding:0 14px;min-height:34px;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}\n  .seg button + button{border-left:1px solid var(--field)}\n  .seg button[aria-pressed=\"true\"]{background:var(--paper);color:#000}\n  .seg button:disabled{cursor:not-allowed}\n  .seg button:disabled:not([aria-pressed=\"true\"]){opacity:.45}\n  .actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n  .hint{font-size:12.5px;color:var(--ash);margin:8px 0 0}\n\n  .picker{display:flex;gap:16px;flex-wrap:wrap;align-items:center;border:1px dashed var(--field);padding:22px}\n  .picker input[type=file]{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}\n  .picker:focus-within{border-color:var(--volt)}\n  .picked{font-family:var(--mono);font-size:13px;overflow-wrap:anywhere;min-width:0}\n  .picked b{font-weight:700}\n\n  progress{width:100%;height:6px;appearance:none;-webkit-appearance:none;border:0;background:var(--line-strong);margin:16px 0 6px}\n  progress::-webkit-progress-bar{background:var(--line-strong)}\n  progress::-webkit-progress-value{background:var(--volt)}\n  progress::-moz-progress-bar{background:var(--volt)}\n\n  .verdict{border:1px solid var(--line-strong);padding:14px 16px;margin:20px 0 0;display:flex;gap:12px;align-items:flex-start}\n  .verdict .i{margin-top:3px}\n  .verdict strong{display:block;font-size:16px}\n  .verdict p{margin:4px 0 0;font-size:13.5px;color:var(--ash)}\n  .verdict.ok{border-color:var(--ok)}\n  .verdict.ok strong,.verdict.ok .i{color:var(--ok)}\n  .verdict.bad{border-color:var(--danger)}\n  .verdict.bad strong,.verdict.bad .i{color:var(--danger)}\n  .out{margin:16px 0 0}\n  .out output{display:block;font-family:var(--mono);font-size:13px;overflow-wrap:anywhere;word-break:break-all;background:#000;border:1px solid var(--line-strong);padding:10px 12px;user-select:all;-webkit-user-select:all}\n  .msg{min-height:1.5em;margin:10px 0 0;font-size:13px;color:var(--ash)}\n  footer{border-top:1px solid var(--line);padding:24px 0 40px;color:var(--ash);font-size:12.5px}\n  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}\n</style>\n</head>\n<body>\n<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\" focusable=\"false\">\n  <symbol id=\"i-shield\" viewBox=\"0 0 24 24\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></symbol>\n  <symbol id=\"i-lock\" viewBox=\"0 0 24 24\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4\"/><path d=\"M12 8h.01\"/></symbol>\n  <symbol id=\"i-upload\" viewBox=\"0 0 24 24\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"17 8 12 3 7 8\"/><line x1=\"12\" x2=\"12\" y1=\"3\" y2=\"15\"/></symbol>\n  <symbol id=\"i-copy\" viewBox=\"0 0 24 24\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></symbol>\n  <symbol id=\"i-cross\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m15 9-6 6\"/><path d=\"m9 9 6 6\"/></symbol>\n  <symbol id=\"i-hash\" viewBox=\"0 0 24 24\"><line x1=\"4\" x2=\"20\" y1=\"9\" y2=\"9\"/><line x1=\"4\" x2=\"20\" y1=\"15\" y2=\"15\"/><line x1=\"10\" x2=\"8\" y1=\"3\" y2=\"21\"/><line x1=\"16\" x2=\"14\" y1=\"3\" y2=\"21\"/></symbol>\n  <symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></symbol>\n</svg>\n\n<header class=\"bar\">\n  <div class=\"wrap bar-in\">\n    <div class=\"mark\">\n      <span class=\"ets-badge\" aria-hidden=\"true\"><span class=\"ets\">ETS</span></span>\n      <span class=\"wordmark\">Enigma <b>/</b> Hash Check</span>\n    </div>\n  </div>\n</header>\n\n<main class=\"wrap\">\n  <div class=\"hero\">\n    <p class=\"eyebrow\">Tool for Sanctum</p>\n    <h1>Is it the<span class=\"dash\" aria-hidden=\"true\"></span>file?</h1>\n    <p class=\"lede\">Compare a downloaded file with the checksum its publisher gave you. <span>Installers, disk images, firmware, documents. The file is read in this window and never leaves it.</span></p>\n  </div>\n\n  <div class=\"facts\" role=\"list\" aria-label=\"What this tool does with your files\">\n    <div class=\"fact\" role=\"listitem\"><h3><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-lock\"/></svg>Stays here</h3><p>The file is read in small pieces and hashed on this computer. Nothing is uploaded, stored or sent.</p></div>\n    <div class=\"fact\" role=\"listitem\"><h3><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-shield\"/></svg>Asks for nothing</h3><p>No network, no devices, no storage. The approval screen in Sanctum is empty.</p></div>\n    <div class=\"fact\" role=\"listitem\"><h3><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-info\"/></svg>A match has limits</h3><p>It shows the file is the one the checksum was made from. It does not show the checksum came from the publisher.</p></div>\n  </div>\n\n  <section class=\"block\" aria-labelledby=\"h-file\">\n    <p class=\"kicker\">Step 1</p>\n    <h2 id=\"h-file\">Choose the file</h2>\n    <p class=\"muted small\" style=\"margin:0 0 18px\">Any size. Large files take a while, and you can stop at any time.</p>\n    <div class=\"picker\">\n      <button class=\"btn\" type=\"button\" id=\"choose\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-upload\"/></svg>Choose a file</button>\n      <input type=\"file\" id=\"picker\" aria-label=\"File to check\" tabindex=\"-1\">\n      <span class=\"picked muted\" id=\"picked\">No file chosen.</span>\n    </div>\n  </section>\n\n  <section class=\"block\" aria-labelledby=\"h-sum\">\n    <p class=\"kicker\">Step 2</p>\n    <h2 id=\"h-sum\">Paste the checksum</h2>\n    <p class=\"muted small\" style=\"margin:0 0 18px\">Optional. Paste one checksum, or the whole contents of a file such as SHA256SUMS. Without one, the tool only shows the file's hash.</p>\n    <label class=\"lab\" for=\"expected\"><span>Checksum from the publisher</span></label>\n    <textarea id=\"expected\" spellcheck=\"false\" autocomplete=\"off\" aria-describedby=\"expected-note\" placeholder=\"e3b0c442...  installer.dmg\"></textarea>\n    <p class=\"hint\" id=\"expected-note\" role=\"status\" aria-live=\"polite\">Reads a plain hash, <code>sha256:</code> hash, GNU lines (<code>hash  name</code>) and BSD lines (<code>SHA256 (name) = hash</code>).</p>\n    <div style=\"margin-top:18px\">\n      <span class=\"lab\" id=\"lab-alg\"><span>Algorithm</span></span>\n      <div class=\"seg\" id=\"algs\" role=\"group\" aria-labelledby=\"lab-alg\">\n        <button type=\"button\" data-alg=\"sha256\" aria-pressed=\"true\">SHA-256</button>\n        <button type=\"button\" data-alg=\"sha384\" aria-pressed=\"false\">SHA-384</button>\n        <button type=\"button\" data-alg=\"sha512\" aria-pressed=\"false\">SHA-512</button>\n      </div>\n      <p class=\"hint\" id=\"alg-note\">SHA-256 is what most publishers use. A pasted checksum sets this by its length.</p>\n    </div>\n  </section>\n\n  <section class=\"block\" aria-labelledby=\"h-run\">\n    <p class=\"kicker\">Step 3</p>\n    <h2 id=\"h-run\">Check</h2>\n    <div class=\"actions\" style=\"margin-top:14px\">\n      <button class=\"btn\" type=\"button\" id=\"run\" disabled><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-hash\"/></svg>Check file</button>\n      <button class=\"btn ghost\" type=\"button\" id=\"cancel\" hidden><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-x\"/></svg>Stop</button>\n    </div>\n    <progress id=\"bar\" max=\"1\" value=\"0\" hidden aria-label=\"Progress\"></progress>\n    <p class=\"msg\" id=\"msg\" role=\"status\" aria-live=\"polite\"></p>\n    <div id=\"result\" hidden>\n      <div class=\"verdict\" id=\"verdict\" role=\"status\" aria-live=\"polite\">\n        <svg class=\"i\" aria-hidden=\"true\" id=\"verdict-icon\"><use href=\"#i-info\"/></svg>\n        <div><strong id=\"verdict-title\"></strong><p id=\"verdict-body\"></p></div>\n      </div>\n      <div class=\"out\">\n        <span class=\"lab\"><span id=\"out-label\">Hash of the file</span></span>\n        <p class=\"picked muted\" id=\"out-file\" style=\"margin:0 0 8px\"></p>\n        <output id=\"computed\" for=\"picker\"></output>\n        <div class=\"actions\" style=\"margin-top:10px\">\n          <button class=\"btn ghost sm\" type=\"button\" id=\"copy\"><svg class=\"i\" aria-hidden=\"true\"><use href=\"#i-copy\"/></svg>Copy hash</button>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"wrap\">Enigma Hash Check <span id=\"ver\"></span>. Part of Sanctum, AGPL-3.0. SHA-2 as defined in FIPS 180-4. Icons from Lucide (ISC).</div>\n</footer>\n\n<script>\n/*\n * Hash Check core for the Sanctum example tool.\n *\n * Plain script: no DOM, no imports, no network, no dynamic code. Synchronous.\n * It sets globalThis.HashCore and, under Node, module.exports.\n *\n * SHA-256, SHA-384 and SHA-512 (FIPS 180-4) with a streaming interface, so a file of any\n * size can be read in pieces. The constants are not typed in: they are the fractional parts\n * of the square and cube roots of the first primes, computed once at load with BigInt, as\n * the standard defines them. The known answers in the test folder prove the result.\n * SHA-512 works on pairs of 32-bit words because 64-bit integers are slow in a browser.\n *\n * Also reads the text people paste: a bare checksum, \"sha256:...\" , GNU \"hash  name\" lines\n * and BSD \"SHA256 (name) = hash\" lines.\n */\n(function () {\n  \"use strict\";\n\n  var ALGS = Object.freeze({\n    sha256: Object.freeze({ id: \"sha256\", label: \"SHA-256\", hexLength: 64 }),\n    sha384: Object.freeze({ id: \"sha384\", label: \"SHA-384\", hexLength: 96 }),\n    sha512: Object.freeze({ id: \"sha512\", label: \"SHA-512\", hexLength: 128 }),\n  });\n\n  function HashError(code, message) {\n    var e = new Error(message);\n    e.name = \"HashError\";\n    e.code = code;\n    return e;\n  }\n\n  // ---------------------------------------------------------------- constants\n\n  var MASK64 = (1n << 64n) - 1n;\n\n  function primes(count) {\n    var out = [];\n    for (var n = 2; out.length < count; n++) {\n      var prime = true;\n      for (var i = 0; i < out.length && out[i] * out[i] <= n; i++) {\n        if (n % out[i] === 0) { prime = false; break; }\n      }\n      if (prime) out.push(n);\n    }\n    return out;\n  }\n\n  // floor(n ^ (1/k)) for BigInt n, by Newton's method from above.\n  function iroot(n, k) {\n    if (n < 2n) return n;\n    var kk = BigInt(k);\n    var x = 1n << BigInt(Math.ceil(n.toString(2).length / k));\n    for (;;) {\n      var y = ((kk - 1n) * x + n / x ** (kk - 1n)) / kk;\n      if (y >= x) return x;\n      x = y;\n    }\n  }\n\n  var P = primes(80);\n  // Fractional part of the cube root of the first 80 primes, to 64 bits: SHA-512's K.\n  var K_HI = new Uint32Array(80);\n  var K_LO = new Uint32Array(80);\n  for (var i = 0; i < 80; i++) {\n    var kc = iroot(BigInt(P[i]) << 192n, 3) & MASK64;\n    K_HI[i] = Number(kc >> 32n);\n    K_LO[i] = Number(kc & 0xffffffffn);\n  }\n  // SHA-256 uses the top 32 bits of the first 64 of those.\n  var K256 = K_HI.slice(0, 64);\n\n  // Fractional part of the square root of a prime, to 64 bits, as [hi, lo].\n  function sqrtFrac(p) {\n    var v = iroot(BigInt(p) << 128n, 2) & MASK64;\n    return [Number(v >> 32n), Number(v & 0xffffffffn)];\n  }\n  var INIT512 = new Uint32Array(16); // first 8 primes\n  var INIT384 = new Uint32Array(16); // primes 9 to 16\n  var INIT256 = new Uint32Array(8); // top 32 bits of the first 8 primes\n  for (var j = 0; j < 8; j++) {\n    var a = sqrtFrac(P[j]);\n    INIT512[2 * j] = a[0];\n    INIT512[2 * j + 1] = a[1];\n    INIT256[j] = a[0];\n    var b = sqrtFrac(P[8 + j]);\n    INIT384[2 * j] = b[0];\n    INIT384[2 * j + 1] = b[1];\n  }\n\n  // ---------------------------------------------------------------- SHA-256\n\n  function rotr32(x, n) {\n    return (x >>> n) | (x << (32 - n));\n  }\n\n  var W256 = new Uint32Array(64);\n\n  function compress256(H, data, off) {\n    var W = W256;\n    var t;\n    for (t = 0; t < 16; t++) {\n      var p = off + 4 * t;\n      W[t] = ((data[p] << 24) | (data[p + 1] << 16) | (data[p + 2] << 8) | data[p + 3]) >>> 0;\n    }\n    for (t = 16; t < 64; t++) {\n      var w15 = W[t - 15];\n      var w2 = W[t - 2];\n      var s0 = rotr32(w15, 7) ^ rotr32(w15, 18) ^ (w15 >>> 3);\n      var s1 = rotr32(w2, 17) ^ rotr32(w2, 19) ^ (w2 >>> 10);\n      W[t] = (W[t - 16] + s0 + W[t - 7] + s1) >>> 0;\n    }\n    var a = H[0], b = H[1], c = H[2], d = H[3], e = H[4], f = H[5], g = H[6], h = H[7];\n    for (t = 0; t < 64; t++) {\n      var S1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);\n      var ch = (e & f) ^ (~e & g);\n      var t1 = (h + S1 + ch + K256[t] + W[t]) >>> 0;\n      var S0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);\n      var maj = (a & b) ^ (a & c) ^ (b & c);\n      var t2 = (S0 + maj) >>> 0;\n      h = g; g = f; f = e;\n      e = (d + t1) >>> 0;\n      d = c; c = b; b = a;\n      a = (t1 + t2) >>> 0;\n    }\n    H[0] = (H[0] + a) >>> 0; H[1] = (H[1] + b) >>> 0; H[2] = (H[2] + c) >>> 0; H[3] = (H[3] + d) >>> 0;\n    H[4] = (H[4] + e) >>> 0; H[5] = (H[5] + f) >>> 0; H[6] = (H[6] + g) >>> 0; H[7] = (H[7] + h) >>> 0;\n  }\n\n  // ---------------------------------------------------------------- SHA-512\n\n  var W512 = new Uint32Array(160); // 80 words as [hi, lo]\n\n  // Rotate right a 64-bit value (hi, lo) by n bits, 0 < n < 32; the result goes to R